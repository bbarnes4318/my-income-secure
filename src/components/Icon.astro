---
// ---------------------------------------------------------------------------
// Inline SVG icon set. No library, no icon font.
//
// Drawn on a 24-unit grid with a 1.75 stroke so they sit at the weight of
// Archivo's mid range rather than looking pasted on. All strokes inherit
// currentColor, so an icon takes the colour of whatever it sits in and the
// gap palette is never applied here by accident.
//
// Each one depicts the specific thing it labels. Nothing generic.
// ---------------------------------------------------------------------------

interface Props {
  name:
    | 'calculator'    // find your number
    | 'ladder'        // pick the tier
    | 'payout'        // it pays out
    | 'calendar'      // the 30-day threshold
    | 'installments'  // three payments then it stops
    | 'shield'        // has to be in place first
    | 'filing'        // file with your state
    | 'attest'        // what you attest to
    | 'refund';       // cancelling and refunds
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/* A form with a total ruled off at the bottom. */}
  {name === 'calculator' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="2" />
      <path d="M8 8h8" />
      <path d="M8 12h4" />
      <path d="M7 16.5h10" />
      <path d="M14.5 12.5v3" />
    </>
  )}

  {/* Rungs of increasing length — the tier ladder, literally. */}
  {name === 'ladder' && (
    <>
      <path d="M5 18h5" />
      <path d="M5 13.5h9" />
      <path d="M5 9h13" />
      <path d="M5 4.5h6" />
    </>
  )}

  {/* Money arriving: a note with an arrow landing into it. */}
  {name === 'payout' && (
    <>
      <rect x="3" y="10" width="18" height="10" rx="2" />
      <circle cx="12" cy="15" r="2.25" />
      <path d="M12 3v4.5" />
      <path d="M9.5 5.5 12 8l2.5-2.5" />
    </>
  )}

  {/* A calendar with one day marked — the 30-day threshold. */}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="16" rx="2" />
      <path d="M3.5 10h17" />
      <path d="M8 3v4" />
      <path d="M16 3v4" />
      <circle cx="16" cy="15.5" r="1.6" />
    </>
  )}

  {/* Three marks, the third hollow: it stops after a fixed count. */}
  {name === 'installments' && (
    <>
      <circle cx="5.5" cy="12" r="2.5" />
      <circle cx="12" cy="12" r="2.5" />
      <circle cx="18.5" cy="12" r="2.5" stroke-dasharray="2.2 2.2" />
      <path d="M8 12h1.5" />
      <path d="M14.5 12H16" />
    </>
  )}

  {/* A shield with a clock hand: cover, and the timing of it. */}
  {name === 'shield' && (
    <>
      <path d="M12 3 5 6v6c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9V6l-7-3Z" />
      <path d="M12 9v3.5l2.25 1.5" />
    </>
  )}

  {/* A document being sent — filing the claim with the state. */}
  {name === 'filing' && (
    <>
      <path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" />
      <path d="M13.5 3v5h5" />
      <path d="M9 15.5h5" />
      <path d="M12 13l2.5 2.5L12 18" />
    </>
  )}

  {/* A ticked line on a form — the attestations. */}
  {name === 'attest' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="2" />
      <path d="m8 9 1.75 1.75L13 7.5" />
      <path d="m8 16 1.75 1.75L13 14.5" />
      <path d="M15.5 10.5h1.5" />
      <path d="M15.5 17.5h1.5" />
    </>
  )}

  {/* An arrow turning back — money returned, inside a window. */}
  {name === 'refund' && (
    <>
      <path d="M4 12a8 8 0 1 1 2.5 5.8" />
      <path d="M4 7.5V12h4.5" />
      <path d="M12 8.5v7" />
      <path d="M13.75 10.5h-2.5a1.5 1.5 0 0 0 0 3h1.5a1.5 1.5 0 0 1 0 3h-2.5" />
    </>
  )}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
