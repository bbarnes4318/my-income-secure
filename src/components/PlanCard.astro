---
import { isPlanConfigured, isPlanSellable, PROGRAM_TERMS } from '../config/plans.js';
import { money, price, coverageLine } from '../lib/format.js';

interface Props {
  plan: any;
  recommended?: boolean;
  /** Why this tier was recommended, tied to the visitor's own number. */
  reason?: string;
  /** The monthly shortfall, when the calculator has produced one. */
  monthlyGap?: number | null;
  ctaHref: string;
  ctaLabel?: string;
}

const {
  plan,
  recommended = false,
  reason,
  monthlyGap = null,
  ctaHref,
  ctaLabel = 'Choose this plan',
} = Astro.props;

const configured = isPlanConfigured(plan);
const purchasable = isPlanSellable(plan);
const protection = plan.incomeProtection;

// A page whose every call to action is dead teaches visitors the site is
// broken. Until Stripe IDs exist, the card still carries a live primary
// action — it goes to checkout with the tier preselected, which is where it
// would go anyway. That the tier cannot yet be paid for is stated once at the
// section level, not eleven times in eleven greyed-out buttons.
const ctaText = purchasable ? ctaLabel : 'Continue with this tier';

// Only computed when both numbers are real. Never inferred.
const coverage = protection ? coverageLine(plan, monthlyGap ?? 0) : null;
const closes =
  protection && typeof monthlyGap === 'number' && monthlyGap > 0
    ? plan.monthlyBenefit >= monthlyGap
    : null;
---

<article
  class:list={['plan', recommended && 'plan--recommended', !protection && 'plan--base']}
  data-plan-id={plan.id}
  data-monthly-benefit={plan.monthlyBenefit ?? ''}
>
  {/* Rendered always, revealed by the calculator once a gap is known. */}
  <p class="plan__flag" data-plan-flag hidden={!recommended}>Recommended for you</p>

  <header class="plan__head">
    <h3 class="plan__name">{plan.name}</h3>

    {
      protection ? (
        <p class="plan__benefit">
          <span class="plan__benefit-value">{money(plan.totalLimit)}</span>
          <span class="plan__benefit-unit">paid to you if you lose your job</span>
          <span class="plan__benefit-total">
            Paid as {plan.installments} payments of {money(plan.monthlyBenefit)},
            {' '}{PROGRAM_TERMS.installmentIntervalDays} days apart &mdash; each
            one only if you are still out of work.
          </span>
        </p>
      ) : (
        <p class="plan__benefit">
          <span class="plan__benefit-none">No income protection</span>
          <span class="plan__benefit-unit">
            The base membership. It pays nothing if you lose your job.
          </span>
        </p>
      )
    }
  </header>

  <p
    class:list={['plan__coverage', closes === false && 'plan__coverage--partial']}
    data-plan-coverage
    hidden={!coverage}
  >
    {coverage}
  </p>
  <p class="plan__reason" data-plan-reason hidden={!(recommended && reason)}>
    {recommended && reason ? reason : ''}
  </p>

  <p class="plan__price">
    <span class="plan__price-value">{price(plan.priceMonthly)}</span>
    <span class="plan__price-unit">/month membership</span>
  </p>

  {
    plan.features.length > 0 && (
      <ul class="plan__features">
        {plan.features.map((f: string) => (
          <li>{f}</li>
        ))}
      </ul>
    )
  }

  <a
    class:list={['btn', recommended ? 'btn--primary' : 'btn--secondary', 'btn--block']}
    href={ctaHref}
    data-plan-cta={plan.id}
  >
    {ctaText}
  </a>
</article>

<style>
  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-5);
  }

  /* The recommendation is dominant, not merely badged. Nothing else on the
     ladder gets emphasis — no "most popular", no upward nudge. This treatment
     appears only on the tier that answers the visitor's own number. */
  .plan--recommended {
    border: 2px solid var(--navy);
    box-shadow: var(--shadow-lift);
    padding: var(--space-6);
  }

  .plan--base {
    background: var(--paper-alt);
  }

  .plan__flag {
    align-self: flex-start;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    font-stretch: var(--widest);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
  }

  .plan__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .plan__name {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
  }

  .plan__benefit {
    display: flex;
    flex-direction: column;
  }

  .plan__benefit-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    font-stretch: var(--wide);
    color: var(--navy);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .plan--recommended .plan__benefit-value {
    font-size: var(--text-3xl);
  }

  .plan__benefit-none {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .plan__benefit-unit,
  .plan__price-unit {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  /* The total and the interval are part of the benefit figure, not a footnote,
     so they sit inside the same block and cannot be laid out away from it. */
  .plan__benefit-total {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    border-left: 2px solid var(--line-strong);
    padding-left: var(--space-3);
  }

  .plan__coverage {
    align-self: flex-start;
    background: var(--covered-wash);
    border: 1px solid var(--covered-line);
    color: var(--covered-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  /* Amber is the shortfall. A tier that leaves part of the gap open is still
     showing a shortfall, so it keeps the shortfall colour. */
  .plan__coverage--partial {
    background: var(--uncovered-wash);
    border-color: var(--uncovered-line);
    color: var(--uncovered-ink);
  }

  .plan__reason {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    margin-top: auto;
  }

  .plan__price-value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .plan__features {
    margin: 0;
    padding-left: 1.125rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .plan__features li + li {
    margin-top: var(--space-2);
  }

</style>
