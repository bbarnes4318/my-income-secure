---
// ---------------------------------------------------------------------------
// A sliding three-tier window over the full tier ladder.
//
// Every card renders server-side into a scroll track. JavaScript narrows
// the view to three; without JavaScript the whole ladder is there and scrolls,
// which is a worse experience but never a broken one.
//
// Deliberately absent: any default that steers. With no computed gap the window
// opens at the BOTTOM of the ladder — the cheapest tiers — and the page's
// primary action is the calculator, not a tier. Choosing a middle or upper
// window for a cold visitor would be a guess dressed as a recommendation.
// ---------------------------------------------------------------------------
import PlanCard from './PlanCard.astro';
import { PLANS, isPlanSellable } from '../config/plans.js';
import { ROUTES } from '../config/site.js';

interface Props {
  /** Where the analytics event is fired from: "plans", "result". */
  placement: string;
  /** Tier id to mark as recommended, when a gap has been computed. */
  recommendedId?: string | null;
  reason?: string;
  monthlyGap?: number | null;
}

const {
  placement,
  recommendedId = null,
  reason,
  monthlyGap = null,
} = Astro.props;

const WINDOW = 3;

// Said once, here, rather than repeated on every card as a dead button.
const anyPurchasable = PLANS.some(isPlanSellable);
---

<section
  class="window"
  data-plan-window
  data-placement={placement}
  data-window-size={WINDOW}
  aria-label="Plan tiers"
>
  <div class="window__controls">
    <button
      type="button"
      class="window__step"
      data-window-prev
      aria-label="Show lower tiers"
    >
      <span aria-hidden="true">&larr;</span>
    </button>

    <div class="window__rail" data-window-rail aria-hidden="true">
      {PLANS.map(() => <span class="window__notch" />)}
    </div>

    <button
      type="button"
      class="window__step"
      data-window-next
      aria-label="Show higher tiers"
    >
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>

  <p class="window__position" data-window-position aria-live="polite">
    Showing all {PLANS.length} tiers.
  </p>

  <div class="window__track" data-window-track>
    {
      PLANS.map((plan, i) => (
        <div class="window__slot" data-window-index={i}>
          <p class="window__label" data-window-label hidden />
          <PlanCard
            plan={plan}
            recommended={plan.id === recommendedId}
            reason={plan.id === recommendedId ? reason : undefined}
            monthlyGap={monthlyGap}
            ctaHref={`${ROUTES.checkout}?plan=${plan.id}`}
          />
        </div>
      ))
    }
  </div>

  <div class="window__foot">
    <a class="window__help" href={ROUTES.calculator}>
      Not sure which? Work out your shortfall first.
    </a>
    {
      !anyPurchasable && (
        <p class="window__pending">
          <strong>Enrollment opens shortly.</strong> You can pick your tier now
          and see exactly what it pays; card payment is not switched on yet.
        </p>
      )
    }
  </div>
</section>

<script>
  import { track, trackOnVisible, EVENTS } from '../lib/analytics.js';
  import { loadCalcResult } from '../lib/storage.js';
  import { coverageLine, money } from '../lib/format.js';
  import { findPlan, recommendPlan, PLANS } from '../config/plans.js';

  // Positional labels for the three visible slots. They describe where a tier
  // sits in the current view, not what it is worth — so they move with the
  // window and never attach to a particular tier.
  const LABELS = ['Good', 'Better', 'Best'];

  document.querySelectorAll('[data-plan-window]').forEach((root) => {
    const placement = root.dataset.placement;
    const size = Number(root.dataset.windowSize) || 3;
    const slots = [...root.querySelectorAll('[data-window-index]')];
    const notches = [...root.querySelectorAll('.window__notch')];
    const prev = root.querySelector('[data-window-prev]');
    const next = root.querySelector('[data-window-next]');
    const position = root.querySelector('[data-window-position]');
    const maxStart = Math.max(0, slots.length - size);

    let start = 0;

    function render() {
      slots.forEach((slot, i) => {
        const inWindow = i >= start && i < start + size;
        slot.hidden = !inWindow;
        const label = slot.querySelector('[data-window-label]');
        if (inWindow) {
          label.textContent = LABELS[i - start] ?? '';
          label.hidden = false;
        } else {
          label.hidden = true;
        }
      });

      notches.forEach((n, i) => {
        n.classList.toggle('is-active', i >= start && i < start + size);
      });

      prev.disabled = start === 0;
      next.disabled = start >= maxStart;

      const shown = PLANS.slice(start, start + size);
      position.textContent =
        `Tiers ${start + 1}–${start + size} of ${PLANS.length}: ` +
        shown.map((p) => p.name).join(', ') + '.';
    }

    function move(delta) {
      const wanted = Math.min(Math.max(0, start + delta), maxStart);
      if (wanted === start) return;
      start = wanted;
      render();
      track(EVENTS.PLAN_WINDOW, {
        placement,
        direction: delta > 0 ? 'up' : 'down',
        tiers: PLANS.slice(start, start + size).map((p) => p.id),
      });
      // Bring the window back into view on mobile, where the track scrolls.
      slots[start].scrollIntoView({ block: 'nearest', inline: 'start' });
    }

    /**
     * Point the whole window at a shortfall: fill every card's coverage line,
     * mark the one tier that answers it, and open on that tier.
     *
     * With no gap the window sits at the bottom of the ladder. That is the
     * honest default — a visitor without a number has given us nothing to
     * recommend from, and opening higher up would be a nudge, not a suggestion.
     */
    function applyGap(gap) {
      slots.forEach((slot) => {
        const card = slot.querySelector('[data-plan-id]');
        const line = card.querySelector('[data-plan-coverage]');
        const flag = card.querySelector('[data-plan-flag]');
        const reason = card.querySelector('[data-plan-reason]');
        const plan = findPlan(card.dataset.planId);

        card.classList.remove('plan--recommended');
        flag.hidden = true;
        reason.hidden = true;
        reason.textContent = '';

        const text = gap ? coverageLine(plan, gap) : null;
        line.textContent = text || '';
        line.hidden = !text;
        line.classList.toggle(
          'plan__coverage--partial',
          Boolean(gap) && plan.monthlyBenefit < gap
        );
      });

      if (!gap) {
        start = 0;
        render();
        return;
      }

      const { plan, closesGap, index } = recommendPlan(gap);
      if (plan) {
        const card = root.querySelector(`[data-plan-id="${plan.id}"]`);
        if (card) {
          card.classList.add('plan--recommended');
          card.querySelector('[data-plan-flag]').hidden = false;
          const reason = card.querySelector('[data-plan-reason]');
          reason.hidden = false;
          // When nothing closes the gap this says so, rather than presenting
          // the top of the ladder as though it were the answer.
          reason.textContent = closesGap
            ? `The smallest tier that covers your ${money(gap)} shortfall. Nothing above this covers it any better.`
            : `No tier covers ${money(gap)} a month in full. This is the largest, and it leaves ${money(gap - plan.monthlyBenefit)} a month still on you.`;
        }
        if (index >= 0) start = Math.min(Math.max(0, index - 1), maxStart);
      }
      render();
    }

    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); move(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); move(1); }
    });

    // A result computed earlier in this browser, and a result computed live on
    // this page, arrive through the same path.
    const saved = loadCalcResult();
    applyGap(saved && saved.monthlyGap > 0 ? saved.monthlyGap : null);
    document.addEventListener('mis:gap', (e) => {
      const gap = e.detail && e.detail.monthlyGap;
      applyGap(gap > 0 ? gap : null);
    });

    render();
    trackOnVisible(root, EVENTS.PLAN_VIEW, { placement });

    root.querySelectorAll('[data-plan-cta]').forEach((cta) => {
      cta.addEventListener('click', () => {
        const card = cta.closest('[data-plan-id]');
        track(EVENTS.PLAN_SELECT, {
          planId: cta.dataset.planCta,
          placement,
          recommended: card?.classList.contains('plan--recommended') ?? false,
        });
      });
    });
  });
</script>

<style>
  .window {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .window__controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .window__step {
    flex: none;
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--navy);
    font-size: var(--text-md);
    cursor: pointer;
  }

  .window__step:disabled {
    color: var(--line-strong);
    cursor: not-allowed;
  }

  .window__step:not(:disabled):hover {
    border-color: var(--navy);
  }

  /* The rail exists so the ladder's length is visible — you are looking at
     three of however many there are. Without it the window hides its scope. */
  .window__rail {
    flex: 1;
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .window__notch {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
  }

  .window__notch.is-active {
    background: var(--navy);
  }

  .window__position {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .window__track {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: stretch;
  }

  .window__slot[hidden] {
    display: none;
  }

  .window__slot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    scroll-snap-align: start;
  }

  .window__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    font-stretch: var(--widest);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .window__foot {
    display: grid;
    gap: var(--space-4);
  }

  .window__help {
    font-size: var(--text-sm);
  }

  .window__pending {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius);
    background: var(--blue-pale);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-flat);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .window__pending strong {
    color: var(--navy);
    font-family: var(--font-display);
    font-stretch: 105%;
  }

  /* Below 780px three cards cannot sit side by side, so the window becomes a
     snap track: the buttons still move it, and a swipe works too. */
  @media (max-width: 779px) {
    .window__track {
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--space-2);
      /* Card shadows and the recommended border must not be clipped. */
      margin-inline: calc(var(--space-4) * -1);
      padding-inline: var(--space-4);
    }
  }

  @media (min-width: 780px) {
    .window__track {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }
</style>
