---
// The funnel's spine: one question per screen, then one recommendation.
//
// Reuses the same state-formula functions and plan data as the standalone
// calculator at ROUTES.calculator — that page is untouched, this is a separate,
// trimmed embed built for the homepage specifically. No plan window, no
// three-card grid: the result is a single recommended tier, because a funnel
// presents one offer.
//
// Layout contract: exactly one step is ever visible. The steps container is
// given a JS-measured min-height equal to the tallest step at the current
// viewport width, so switching steps never changes the container's size —
// there is nothing to scroll to. The hero above collapses to a compact strip
// the moment the first question is answered, which is what actually buys the
// room for the later, taller steps to fit above the fold on a phone.
import GapBar from './GapBar.astro';
import PlanCard from './PlanCard.astro';
import { STATES } from '../lib/states.js';
import { PLANS, ELIGIBILITY_CRITERIA } from '../config/plans.js';
import { ROUTES } from '../config/site.js';
---

<div class="flow" data-flow>
  {/* Step 0 sits directly under the hero copy — nothing else competes with it. */}
  <section class="flow__question" id="coverage-check" data-flow-form>
    <div class="shell">
      <p class="flow__meta">Four short questions &mdash; takes about a minute.</p>

      <div class="progress" data-progress aria-hidden="true">
        <span class="progress__dot" data-progress-step="0"></span>
        <span class="progress__dot" data-progress-step="1"></span>
        <span class="progress__dot" data-progress-step="2"></span>
        <span class="progress__dot" data-progress-step="3"></span>
      </div>

      <form class="flow__form" data-flow-steps novalidate>
        <div class="flow__steps-wrap" data-steps-wrap>
          <fieldset class="fstep" data-step="0">
            <legend class="fstep__q">Which state do you work in?</legend>
            <label class="visually-hidden" for="flow-state">Your state</label>
            <select id="flow-state" data-field="state">
              <option value="" selected disabled>Choose your state&hellip;</option>
              {STATES.map((s) => <option value={s.code}>{s.name}</option>)}
            </select>

            <p class="flow__trust">
              Figures come from the U.S. Department of Labor's published state
              formulas. Cancel within 48 hours of enrolling for a full refund.
            </p>
          </fieldset>

          <fieldset class="fstep" data-step="1" hidden>
            <legend class="fstep__q">Roughly what do you earn a year?</legend>
            <p class="fstep__help">Gross, before tax.</p>
            <div class="field">
              <label for="flow-income">Annual income</label>
              <div class="input-money">
                <span aria-hidden="true">$</span>
                <input
                  type="number"
                  id="flow-income"
                  data-field="income"
                  inputmode="numeric"
                  min="0"
                  step="1000"
                  placeholder="52,000"
                  autocomplete="off"
                />
              </div>
            </div>
            <div class="field" data-deps-field hidden>
              <label for="flow-deps">Number of dependants</label>
              <input
                type="number"
                id="flow-deps"
                data-field="deps"
                inputmode="numeric"
                min="0"
                max="10"
                value="0"
              />
              <p class="hint" data-deps-hint></p>
            </div>
            <div class="flow__actions">
              <button type="button" class="btn btn--secondary" data-back>&larr; Back</button>
              <button type="button" class="btn btn--primary" data-next>Continue</button>
            </div>
          </fieldset>

          <fieldset class="fstep" data-step="2" hidden>
            <legend class="fstep__q">What does your month cost?</legend>
            <p class="fstep__help">Round numbers are fine.</p>
            <div class="field">
              <label for="flow-housing">Housing</label>
              <div class="input-money">
                <span aria-hidden="true">$</span>
                <input type="number" id="flow-housing" data-field="housing" data-expense min="0" step="50" placeholder="1,400" autocomplete="off" />
              </div>
            </div>
            <div class="field">
              <label for="flow-vehicle">Vehicle</label>
              <div class="input-money">
                <span aria-hidden="true">$</span>
                <input type="number" id="flow-vehicle" data-field="vehicle" data-expense min="0" step="25" placeholder="450" autocomplete="off" />
              </div>
            </div>
            <div class="field">
              <label for="flow-other">Everything else</label>
              <div class="input-money">
                <span aria-hidden="true">$</span>
                <input type="number" id="flow-other" data-field="other" data-expense min="0" step="50" placeholder="750" autocomplete="off" />
              </div>
            </div>
            <div class="flow__actions">
              <button type="button" class="btn btn--secondary" data-back>&larr; Back</button>
              <button type="button" class="btn btn--primary" data-next>Continue</button>
            </div>
          </fieldset>

          <fieldset class="fstep" data-step="3" hidden>
            <legend class="fstep__q">Last thing &mdash; what has to be true of you.</legend>
            <div class="flow__checks">
              {
                ELIGIBILITY_CRITERIA.map((c) => (
                  <label class="check">
                    <input type="checkbox" data-eligibility={c.id} data-required={c.required ? 'true' : 'false'} />
                    <span>
                      {c.label}
                      {c.detail && <span class="check__detail">{c.detail}</span>}
                    </span>
                  </label>
                ))
              }
            </div>
            <div class="flow__actions">
              <button type="button" class="btn btn--secondary" data-back>&larr; Back</button>
              <button type="button" class="btn btn--primary" data-next>See what I'd get</button>
            </div>
          </fieldset>
        </div>

        <p class="flow__error" data-error role="alert" hidden></p>
      </form>
    </div>
  </section>

  {/* The result: one figure, one plan, in a single deliberate composition
      that uses the full width — this is where the sale happens, rendered in
      place, no navigation. */}
  <section class="flow__result section section--deep section--generous" data-flow-result hidden>
    <div class="shell flow__result-shell">
      <div class="flow__result-figure">
        <GapBar
          id="flow-gap"
          eyebrow="What your month leaves uncovered"
          unit="short every month"
          coveredLabel="Your state pays"
          uncoveredLabel="You cover this yourself"
        />
        <p class="flow__result-fact" data-out="fact"></p>
      </div>

      <div class="flow__result-plan">
        <div class="flow__plan" data-flow-plan>
          {
            PLANS.map((plan) => (
              <div class="flow__plan-card" data-flow-card={plan.id} hidden>
                <PlanCard
                  plan={plan}
                  recommended
                  reason=""
                  ctaHref={`${ROUTES.checkout}?plan=${plan.id}`}
                  ctaLabel="Get this plan"
                />
              </div>
            ))
          }
        </div>

        <p class="flow__alt">
          <button type="button" class="linkish" data-flow-restart>See a different amount &rarr;</button>
        </p>
      </div>
    </div>
  </section>
</div>

<script>
  import {
    STATES,
    findState,
    hasDependentAllowance,
    computeWeeklyBenefit,
    toMonthly,
  } from '../lib/states.js';
  import { recommendPlan } from '../config/plans.js';
  import { renderGap } from '../lib/gap-bar.js';
  import { money } from '../lib/format.js';
  import { saveCalcResult } from '../lib/storage.js';
  import { track, EVENTS, CALC_STEPS } from '../lib/analytics.js';

  const root = document.querySelector('[data-flow]');
  if (root) {
    const hero = document.querySelector('.hero');
    const formSection = root.querySelector('[data-flow-form]');
    const resultSection = root.querySelector('[data-flow-result]');
    const stepsWrap = root.querySelector('[data-steps-wrap]');
    const stepEls = [...root.querySelectorAll('[data-step]')];
    const errorEl = root.querySelector('[data-error]');

    const stateSel = root.querySelector('[data-field="state"]');
    const incomeInput = root.querySelector('[data-field="income"]');
    const depsField = root.querySelector('[data-deps-field]');
    const depsInput = root.querySelector('[data-field="deps"]');
    const depsHint = root.querySelector('[data-deps-hint]');
    const expenseInputs = [...root.querySelectorAll('[data-expense]')];

    let step = 0;

    track(EVENTS.CALC_START, {});

    // --- Fixed-height step container -------------------------------------
    // Every step is measured off-flow at the current width, and the wrap is
    // sized to the tallest one. Switching steps then never changes the
    // container's height, so there is nothing for the layout to shift.
    function sizeStepsWrap() {
      let max = 0;
      stepEls.forEach((el) => {
        const wasHidden = el.hidden;
        el.hidden = false;
        el.style.position = 'absolute';
        el.style.visibility = 'hidden';
        el.style.inlineSize = '100%';
        const h = el.getBoundingClientRect().height;
        if (h > max) max = h;
        el.style.position = '';
        el.style.visibility = '';
        el.style.inlineSize = '';
        el.hidden = wasHidden;
      });
      stepsWrap.style.minHeight = Math.ceil(max) + 'px';
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(sizeStepsWrap, 150);
    });

    function showStep(n, { focus = true } = {}) {
      step = n;
      stepEls.forEach((el, i) => { el.hidden = i !== n; });
      errorEl.hidden = true;
      root.querySelectorAll('[data-progress-step]').forEach((el, i) => {
        el.dataset.state = i < n ? 'done' : i === n ? 'current' : 'todo';
      });
      // The full hero has already done its job once the visitor is answering
      // questions — collapse it so the active step has room to sit above the
      // fold. Step 0 keeps the full hero, since that is the first thing seen.
      if (hero) hero.classList.toggle('hero--compact', n > 0);
      if (focus) {
        const first = stepEls[n].querySelector('select, input');
        if (first) first.focus({ preventScroll: true });
      }
    }

    function fail(message) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function expenseTotal() {
      return expenseInputs.reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
    }

    function validate(n) {
      if (n === 0 && !stateSel.value) return 'Choose your state to continue.';
      if (n === 1) {
        const v = parseFloat(incomeInput.value);
        if (!v || v <= 0) return 'Enter your approximate annual income.';
      }
      if (n === 2 && expenseTotal() <= 0) return 'Enter at least one monthly cost.';
      return null;
    }

    function advance() {
      const problem = validate(step);
      if (problem) { fail(problem); return; }
      track(EVENTS.CALC_STEP_COMPLETE, { step: step + 1, stepName: CALC_STEPS[step] });
      if (step === stepEls.length - 1) calculate();
      else showStep(step + 1);
    }

    root.querySelectorAll('[data-next]').forEach((btn) => btn.addEventListener('click', advance));
    root.querySelectorAll('[data-back]').forEach((btn) =>
      btn.addEventListener('click', () => showStep(Math.max(0, step - 1)))
    );

    root.querySelector('[data-flow-steps]').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.tagName === 'INPUT') {
        e.preventDefault();
        advance();
      }
    });

    stateSel.addEventListener('change', () => {
      syncDepsField();
      if (stateSel.value) {
        track(EVENTS.CALC_STEP_COMPLETE, { step: 1, stepName: 'state' });
        showStep(1);
      }
    });

    function syncDepsField() {
      const s = findState(stateSel.value);
      const has = hasDependentAllowance(s);
      depsField.hidden = !has;
      if (has) {
        depsHint.textContent = `${s.name} adds ${money(s.dep)} a week per dependant, up to ${s.depCap}.`;
      }
    }

    function calculate() {
      const s = findState(stateSel.value);
      const income = parseFloat(incomeInput.value) || 0;
      const deps = parseInt(depsInput.value, 10) || 0;
      const monthlyExpenses = expenseTotal();

      const weekly = computeWeeklyBenefit(s, income, deps);
      const monthlyBenefit = toMonthly(weekly);
      const monthlyGap = Math.max(0, monthlyExpenses - monthlyBenefit);

      const result = {
        stateCode: s.code,
        stateName: s.name,
        income,
        deps,
        monthlyExpenses,
        weekly: Math.round(weekly),
        monthlyBenefit: Math.round(monthlyBenefit),
        monthlyGap: Math.round(monthlyGap),
      };

      paint(result, s, { monthlyBenefit, monthlyExpenses, monthlyGap });
      saveCalcResult(result);

      track(EVENTS.GAP_REVEAL, {
        placement: 'homepage_flow',
        state: s.code,
        monthlyGap: result.monthlyGap,
        monthlyBenefit: result.monthlyBenefit,
      });
    }

    // Sections below the flow that repeat what a visitor with a result has
    // already scrolled past. Once a result exists they collapse to what is
    // still relevant — payout mechanics in one line, and the terms — and the
    // FAQ/close (both re-treading ground, and close's own CTA would otherwise
    // point backward into the flow at the exact moment it should point to
    // checkout) are cut entirely.
    const payoutFull = document.querySelector('[data-payout-full]');
    const payoutCondensed = document.querySelector('[data-payout-condensed]');
    const faqSection = document.querySelector('[data-faq-section]');
    const closeSection = document.querySelector('[data-close-section]');

    function setPostResultSections(hasResult) {
      if (payoutFull) payoutFull.hidden = hasResult;
      if (payoutCondensed) payoutCondensed.hidden = !hasResult;
      if (faqSection) faqSection.hidden = hasResult;
      if (closeSection) closeSection.hidden = hasResult;
    }

    // The result replaces the question form in place — same page, no
    // navigation. Its own section owns the scroll into view, which is fine:
    // that is bringing new in-page content into frame, not leaving the page.
    function paint(result, s, raw) {
      formSection.hidden = true;
      resultSection.hidden = false;
      setPostResultSections(true);

      renderGap(document.getElementById('flow-gap'), {
        covered: Math.min(raw.monthlyBenefit, raw.monthlyExpenses),
        uncovered: raw.monthlyGap,
        coveredLabel: `${s.name} pays`,
        uncoveredLabel: 'You cover this yourself',
      });

      root.querySelector('[data-out="fact"]').textContent =
        `${s.name} pays about ${money(raw.monthlyBenefit)} a month against ` +
        `${money(raw.monthlyExpenses)} in bills you told us about.`;

      const cards = [...root.querySelectorAll('[data-flow-card]')];
      cards.forEach((c) => { c.hidden = true; });

      if (raw.monthlyGap > 0) {
        const rec = recommendPlan(raw.monthlyGap);
        if (rec.plan) {
          const card = root.querySelector(`[data-flow-card="${rec.plan.id}"]`);
          if (card) {
            card.hidden = false;
            const reasonEl = card.querySelector('[data-plan-reason]');
            if (reasonEl) {
              reasonEl.hidden = false;
              reasonEl.textContent = rec.closesGap
                ? `The smallest plan that covers your ${money(raw.monthlyGap)} monthly shortfall.`
                : `The largest plan available. It covers part of your ${money(raw.monthlyGap)} shortfall, leaving ${money(raw.monthlyGap - rec.plan.monthlyBenefit)} still on you.`;
            }
          }
        }
      }

      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('flow-gap').setAttribute('tabindex', '-1');
      document.getElementById('flow-gap').focus({ preventScroll: true });
    }

    // "See a different amount" rewinds into the same in-page flow rather than
    // sending anyone to the plans page — no second design, no navigation.
    root.querySelector('[data-flow-restart]').addEventListener('click', () => {
      resultSection.hidden = true;
      formSection.hidden = false;
      setPostResultSections(false);
      showStep(1);
      formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    sizeStepsWrap();
    showStep(0, { focus: false });
  }
</script>

<style>
  .flow__question {
    padding-block: 0 var(--pad-tight);
  }

  .flow__meta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--blue-ink);
    margin-bottom: var(--space-3);
  }

  .progress {
    display: flex;
    gap: 6px;
    margin-bottom: var(--space-4);
  }

  .progress__dot {
    flex: 1;
    max-width: 3rem;
    block-size: 6px;
    border-radius: var(--radius-full);
    background: var(--line-strong);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .progress__dot[data-state='done'] {
    background: var(--covered-ink);
  }

  .progress__dot[data-state='current'] {
    background: var(--gradient-brand);
    box-shadow: 0 0 10px rgba(27, 58, 107, 0.5);
  }

  /* Sized by JS to the tallest step, so switching steps never resizes it. */
  .flow__steps-wrap {
    position: relative;
  }

  .fstep {
    border: 0;
    margin: 0;
    padding: 0;
    max-width: 30rem;
  }

  .fstep__q {
    display: block;
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--navy);
    margin-bottom: var(--space-3);
  }

  .fstep__help {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .field + .field {
    margin-top: var(--space-3);
  }

  #flow-state {
    width: 100%;
    max-width: 26rem;
    min-height: var(--tap);
    padding: 0.875rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: var(--text-base);
    color: var(--ink);
    box-shadow: var(--shadow-flat);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  #flow-state:hover {
    border-color: var(--blue);
  }

  .flow__trust {
    margin-top: var(--space-3);
    max-width: 34rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .input-money {
    display: flex;
    align-items: stretch;
  }

  .input-money > span {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border: 1.5px solid var(--line-strong);
    border-right: 0;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    background: var(--paper-alt);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .input-money input {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .flow__checks {
    display: grid;
    gap: var(--space-2);
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-2);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }

  .check:hover {
    border-color: var(--blue);
  }

  .check:has(input:checked) {
    border-color: var(--navy);
    background: var(--blue-pale);
    box-shadow: 0 0 0 1px var(--navy);
  }

  .check__detail {
    display: block;
    margin-top: 2px;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
  }

  .check input {
    inline-size: 18px;
    block-size: 18px;
    margin-top: 1px;
    flex: none;
    accent-color: var(--navy);
  }

  .flow__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .flow__actions .btn--primary {
    flex: 1;
  }

  .flow__error {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #a3231b;
  }

  /* --- Result: one deliberate two-part composition, full width at desktop.
     The figure establishes the problem; the plan — substantial, not
     incidental — is the answer sitting right beside it.
     The richer ground is scoped to this component only — the standalone
     calculator's result reuses the plain `.section--deep` flat navy and
     stays exactly as it is. --- */
  .flow__result {
    background: var(--gradient-deep);
  }

  .flow__result-shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .flow__result-fact {
    margin-top: var(--space-5);
    max-width: 50ch;
    color: #cbd8ec;
    font-size: var(--text-lg);
  }

  .flow__result-plan {
    display: flex;
    flex-direction: column;
  }

  .flow__plan {
    width: 100%;
    max-width: 30rem;
  }

  /* The card is white, even though its section is the dark ground — so the
     site's "primary buttons invert on dark grounds" rule (meant for buttons
     sitting directly on navy) would otherwise turn this one white-on-white.
     Its true context is the white card, so it keeps normal primary styling. */
  .flow__plan :global(.btn--primary) {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  .flow__plan :global(.btn--primary:hover) {
    background: var(--navy-mid);
    border-color: var(--navy-mid);
  }

  .flow__alt {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  @media (min-width: 860px) {
    .flow__result-shell {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
      gap: var(--space-9);
      align-items: center;
    }

    .flow__plan {
      max-width: 34rem;
    }
  }

  .linkish {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: #a9c4e4;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
