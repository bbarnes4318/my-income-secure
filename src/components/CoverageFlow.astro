---
// The guided coverage check: one question per screen, then one recommendation.
//
// Reuses the same state-formula functions and plan data as the standalone
// calculator at ROUTES.calculator — that page is untouched, this is a separate,
// trimmed embed built for the homepage specifically. No plan window, no
// three-card grid: the result is a single recommended tier, because this
// section presents one offer, not a ladder to browse.
//
// This does not fight for a fixed height or a frozen hero. Each step sizes
// itself naturally; advancing smooth-scrolls the new question into view,
// the same pattern the standalone calculator already uses. If a question
// needs more room than the last one, it takes it.
import GapBar from './GapBar.astro';
import PlanCard from './PlanCard.astro';
import { STATES } from '../lib/states.js';
import { PLANS, ELIGIBILITY_CRITERIA, PROGRAM_TERMS } from '../config/plans.js';
import { ROUTES } from '../config/site.js';

const T = PROGRAM_TERMS;
const steps = ['State', 'Income', 'Expenses', 'Eligibility'];
---

<section class="coverage" id="coverage-check">
  <div class="shell coverage__intro">
    <p class="eyebrow">Your coverage check</p>
    <h2>Let's see what unemployment could cover for you.</h2>
    <p class="lead">
      Four short questions. We use your state's published unemployment
      formula to estimate the gap your household could face.
    </p>
  </div>

  {/* ---- The questions ---- */}
  <div class="shell coverage__shell" data-flow-form>
    <div class="progress" data-progress aria-hidden="true">
      <p class="progress__label">
        Step <span data-progress-current>1</span> of {steps.length}
        <span class="progress__name" data-progress-name>{steps[0]}</span>
      </p>
      <div class="progress__track">
        <div class="progress__fill" data-progress-fill></div>
      </div>
    </div>

    <form class="flow__form" data-flow-steps novalidate>
      <fieldset class="fstep" data-step="0">
        <legend class="fstep__q">Which state do you work in?</legend>
        <p class="fstep__why">
          File where you worked, not where you live &mdash; that is the state
          whose formula sets your benefit.
        </p>
        <label class="visually-hidden" for="flow-state">Your state</label>
        <select id="flow-state" data-field="state">
          <option value="" selected disabled>Choose your state&hellip;</option>
          {STATES.map((s) => <option value={s.code}>{s.name}</option>)}
        </select>
      </fieldset>

      <fieldset class="fstep" data-step="1" hidden>
        <legend class="fstep__q">Roughly what do you earn a year?</legend>
        <p class="fstep__why">Gross, before tax &mdash; this sets your state's weekly benefit amount.</p>
        <div class="field">
          <label for="flow-income">Annual income</label>
          <div class="input-money">
            <span aria-hidden="true">$</span>
            <input
              type="number"
              id="flow-income"
              data-field="income"
              inputmode="numeric"
              min="0"
              step="1000"
              placeholder="52,000"
              autocomplete="off"
            />
          </div>
        </div>
        <div class="field" data-deps-field hidden>
          <label for="flow-deps">Number of dependants</label>
          <input
            type="number"
            id="flow-deps"
            data-field="deps"
            inputmode="numeric"
            min="0"
            max="10"
            value="0"
          />
          <p class="hint" data-deps-hint></p>
        </div>
        <div class="flow__actions">
          <button type="button" class="btn btn--secondary" data-back>&larr; Back</button>
          <button type="button" class="btn btn--primary" data-next>Continue</button>
        </div>
      </fieldset>

      <fieldset class="fstep" data-step="2" hidden>
        <legend class="fstep__q">What does your month cost?</legend>
        <p class="fstep__why">Round numbers are fine &mdash; this is what we compare your state benefit against.</p>
        <div class="field">
          <label for="flow-housing">Housing</label>
          <div class="input-money">
            <span aria-hidden="true">$</span>
            <input type="number" id="flow-housing" data-field="housing" data-expense min="0" step="50" placeholder="1,400" autocomplete="off" />
          </div>
        </div>
        <div class="field">
          <label for="flow-vehicle">Vehicle</label>
          <div class="input-money">
            <span aria-hidden="true">$</span>
            <input type="number" id="flow-vehicle" data-field="vehicle" data-expense min="0" step="25" placeholder="450" autocomplete="off" />
          </div>
        </div>
        <div class="field">
          <label for="flow-other">Everything else</label>
          <div class="input-money">
            <span aria-hidden="true">$</span>
            <input type="number" id="flow-other" data-field="other" data-expense min="0" step="50" placeholder="750" autocomplete="off" />
          </div>
        </div>
        <div class="flow__actions">
          <button type="button" class="btn btn--secondary" data-back>&larr; Back</button>
          <button type="button" class="btn btn--primary" data-next>Continue</button>
        </div>
      </fieldset>

      <fieldset class="fstep" data-step="3" hidden>
        <legend class="fstep__q">Last thing &mdash; what has to be true of you.</legend>
        <p class="fstep__why">
          These are the attestations you make at enrollment, not boxes to
          click past.
        </p>
        <div class="flow__checks">
          {
            ELIGIBILITY_CRITERIA.map((c) => (
              <label class="check">
                <input type="checkbox" data-eligibility={c.id} data-required={c.required ? 'true' : 'false'} />
                <span>
                  {c.label}
                  {c.detail && <span class="check__detail">{c.detail}</span>}
                </span>
              </label>
            ))
          }
        </div>
        <div class="flow__actions">
          <button type="button" class="btn btn--secondary" data-back>&larr; Back</button>
          <button type="button" class="btn btn--primary" data-next>See my protection options</button>
        </div>
      </fieldset>

      <p class="flow__error" data-error role="alert" hidden></p>
    </form>
  </div>

  {/* ---- The result: the problem, then the offer. ---- */}
  <div class="flow__result section--deep" data-flow-result hidden>
    <div class="shell">
      <div class="result__head">
        <p class="eyebrow">Your result</p>
        <h2>Here's the gap, and what closes it.</h2>
      </div>

      <div class="result__grid">
        <div class="result__problem">
          <dl class="result__facts">
            <div class="result__fact">
              <dt>Your unemployment estimate</dt>
              <dd data-out="benefit">&mdash;</dd>
            </div>
            <div class="result__fact">
              <dt>Your estimated monthly expenses</dt>
              <dd data-out="expenses">&mdash;</dd>
            </div>
          </dl>

          <GapBar
            id="flow-gap"
            eyebrow="Monthly gap"
            unit="short every month"
            coveredLabel="Your state pays"
            uncoveredLabel="You cover this yourself"
          />
        </div>

        <div class="result__offer">
          <p class="result__offer-label">Recommended for you</p>
          <div class="flow__plan" data-flow-plan>
            {
              PLANS.map((plan) => (
                <div class="flow__plan-card" data-flow-card={plan.id} hidden>
                  <PlanCard
                    plan={plan}
                    recommended
                    reason=""
                    ctaHref={`${ROUTES.checkout}?plan=${plan.id}`}
                    ctaLabel="Continue with this protection"
                  />
                </div>
              ))
            }
          </div>
          <p class="flow__alt">
            <button type="button" class="linkish" data-flow-restart>See a different amount &rarr;</button>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    STATES,
    findState,
    hasDependentAllowance,
    computeWeeklyBenefit,
    toMonthly,
  } from '../lib/states.js';
  import { recommendPlan } from '../config/plans.js';
  import { renderGap } from '../lib/gap-bar.js';
  import { money } from '../lib/format.js';
  import { saveCalcResult } from '../lib/storage.js';
  import { track, EVENTS, CALC_STEPS } from '../lib/analytics.js';

  const root = document.querySelector('#coverage-check');
  if (root) {
    const formSection = root.querySelector('[data-flow-form]');
    const resultSection = root.querySelector('[data-flow-result]');
    const stepEls = [...root.querySelectorAll('[data-step]')];
    const errorEl = root.querySelector('[data-error]');
    const STEP_NAMES = ['State', 'Income', 'Expenses', 'Eligibility'];

    const stateSel = root.querySelector('[data-field="state"]');
    const incomeInput = root.querySelector('[data-field="income"]');
    const depsField = root.querySelector('[data-deps-field]');
    const depsInput = root.querySelector('[data-field="deps"]');
    const depsHint = root.querySelector('[data-deps-hint]');
    const expenseInputs = [...root.querySelectorAll('[data-expense]')];

    let step = 0;

    track(EVENTS.CALC_START, {});

    function showStep(n, { focus = true, scroll = true } = {}) {
      step = n;
      stepEls.forEach((el, i) => { el.hidden = i !== n; });
      errorEl.hidden = true;

      root.querySelector('[data-progress-current]').textContent = String(n + 1);
      root.querySelector('[data-progress-name]').textContent = STEP_NAMES[n];
      root.querySelector('[data-progress-fill]').style.inlineSize =
        `${((n + 1) / stepEls.length) * 100}%`;

      if (focus) {
        const first = stepEls[n].querySelector('select, input');
        if (first) first.focus({ preventScroll: true });
      }
      if (scroll) {
        stepEls[n].scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function fail(message) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function expenseTotal() {
      return expenseInputs.reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
    }

    function validate(n) {
      if (n === 0 && !stateSel.value) return 'Choose your state to continue.';
      if (n === 1) {
        const v = parseFloat(incomeInput.value);
        if (!v || v <= 0) return 'Enter your approximate annual income.';
      }
      if (n === 2 && expenseTotal() <= 0) return 'Enter at least one monthly cost.';
      return null;
    }

    function advance() {
      const problem = validate(step);
      if (problem) { fail(problem); return; }
      track(EVENTS.CALC_STEP_COMPLETE, { step: step + 1, stepName: CALC_STEPS[step] });
      if (step === stepEls.length - 1) calculate();
      else showStep(step + 1);
    }

    root.querySelectorAll('[data-next]').forEach((btn) => btn.addEventListener('click', advance));
    root.querySelectorAll('[data-back]').forEach((btn) =>
      btn.addEventListener('click', () => showStep(Math.max(0, step - 1)))
    );

    root.querySelector('[data-flow-steps]').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.tagName === 'INPUT') {
        e.preventDefault();
        advance();
      }
    });

    stateSel.addEventListener('change', () => {
      syncDepsField();
      if (stateSel.value) {
        track(EVENTS.CALC_STEP_COMPLETE, { step: 1, stepName: 'state' });
        showStep(1);
      }
    });

    function syncDepsField() {
      const s = findState(stateSel.value);
      const has = hasDependentAllowance(s);
      depsField.hidden = !has;
      if (has) {
        depsHint.textContent = `${s.name} adds ${money(s.dep)} a week per dependant, up to ${s.depCap}.`;
      }
    }

    function calculate() {
      const s = findState(stateSel.value);
      const income = parseFloat(incomeInput.value) || 0;
      const deps = parseInt(depsInput.value, 10) || 0;
      const monthlyExpenses = expenseTotal();

      const weekly = computeWeeklyBenefit(s, income, deps);
      const monthlyBenefit = toMonthly(weekly);
      const monthlyGap = Math.max(0, monthlyExpenses - monthlyBenefit);

      const result = {
        stateCode: s.code,
        stateName: s.name,
        income,
        deps,
        monthlyExpenses,
        weekly: Math.round(weekly),
        monthlyBenefit: Math.round(monthlyBenefit),
        monthlyGap: Math.round(monthlyGap),
      };

      paint(result, s, { monthlyBenefit, monthlyExpenses, monthlyGap });
      saveCalcResult(result);

      track(EVENTS.GAP_REVEAL, {
        placement: 'homepage_flow',
        state: s.code,
        monthlyGap: result.monthlyGap,
        monthlyBenefit: result.monthlyBenefit,
      });
    }

    // The result replaces the questions in place — same page, no navigation.
    function paint(result, s, raw) {
      formSection.hidden = true;
      resultSection.hidden = false;

      root.querySelector('[data-out="benefit"]').textContent = `${money(raw.monthlyBenefit)}/month`;
      root.querySelector('[data-out="expenses"]').textContent = `${money(raw.monthlyExpenses)}/month`;

      renderGap(document.getElementById('flow-gap'), {
        covered: Math.min(raw.monthlyBenefit, raw.monthlyExpenses),
        uncovered: raw.monthlyGap,
        coveredLabel: `${s.name} pays`,
        uncoveredLabel: 'You cover this yourself',
      });

      const cards = [...root.querySelectorAll('[data-flow-card]')];
      cards.forEach((c) => { c.hidden = true; });

      if (raw.monthlyGap > 0) {
        const rec = recommendPlan(raw.monthlyGap);
        if (rec.plan) {
          const card = root.querySelector(`[data-flow-card="${rec.plan.id}"]`);
          if (card) {
            card.hidden = false;
            const reasonEl = card.querySelector('[data-plan-reason]');
            const ctaEl = card.querySelector('[data-plan-cta]');
            if (reasonEl) {
              reasonEl.hidden = false;
              reasonEl.textContent = rec.closesGap
                ? `This closes your ${money(raw.monthlyGap)} monthly shortfall for ${rec.plan.installments} months.`
                : `The largest plan available. It covers part of your ${money(raw.monthlyGap)} shortfall, leaving ${money(raw.monthlyGap - rec.plan.monthlyBenefit)} still on you.`;
            }
            if (ctaEl) {
              ctaEl.textContent = `Continue with ${money(rec.plan.totalLimit)} protection`;
            }
          }
        }
      }

      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('flow-gap').setAttribute('tabindex', '-1');
      document.getElementById('flow-gap').focus({ preventScroll: true });
    }

    // "See a different amount" rewinds into the same in-page flow rather than
    // sending anyone to the plans page — no second design, no navigation.
    root.querySelector('[data-flow-restart]').addEventListener('click', () => {
      resultSection.hidden = true;
      formSection.hidden = false;
      showStep(1);
    });

    showStep(0, { focus: false, scroll: false });
  }
</script>

<style>
  .coverage {
    background: var(--surface-sunken);
    border-block: 1px solid var(--line);
    padding-block: var(--pad-generous);
  }

  .coverage__intro {
    max-width: 46rem;
  }

  .coverage__intro h2 {
    margin-top: var(--space-2);
  }

  .coverage__intro .lead {
    margin-top: var(--space-4);
  }

  .coverage__shell {
    margin-top: var(--space-8);
  }

  /* --- Progress --- */
  .progress {
    max-width: 30rem;
    margin-bottom: var(--space-6);
  }

  .progress__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .progress__name {
    margin-left: var(--space-2);
    padding-left: var(--space-2);
    border-left: 1px solid var(--line-strong);
    font-weight: 700;
    color: var(--navy);
  }

  .progress__track {
    block-size: 4px;
    border-radius: 2px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .progress__fill {
    block-size: 100%;
    background: var(--navy);
    inline-size: 25%;
    transition: inline-size 0.3s ease;
  }

  .fstep {
    border: 0;
    margin: 0;
    padding: 0;
    max-width: 30rem;
  }

  .fstep__q {
    display: block;
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--navy);
    margin-bottom: var(--space-2);
  }

  .fstep__why {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
    max-width: 40ch;
  }

  .field + .field {
    margin-top: var(--space-3);
  }

  #flow-state {
    width: 100%;
    max-width: 26rem;
    min-height: var(--tap);
    padding: 0.875rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: var(--text-base);
    color: var(--ink);
  }

  .input-money {
    display: flex;
    align-items: stretch;
  }

  .input-money > span {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border: 1.5px solid var(--line-strong);
    border-right: 0;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    background: var(--paper-alt);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .input-money input {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .flow__checks {
    display: grid;
    gap: var(--space-3);
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: var(--tap);
    padding: var(--space-3);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
    cursor: pointer;
    background: var(--paper);
  }

  .check:has(input:checked) {
    border-color: var(--navy);
    background: var(--blue-pale);
  }

  .check__detail {
    display: block;
    margin-top: 2px;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
  }

  .check input {
    inline-size: 18px;
    block-size: 18px;
    margin-top: 1px;
    flex: none;
    accent-color: var(--navy);
  }

  .flow__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .flow__actions .btn--primary {
    flex: 1;
  }

  .flow__error {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #a3231b;
  }

  /* --- Result --- */
  .flow__result {
    background: var(--navy-deep);
    padding-block: var(--pad-generous);
  }

  .result__head h2 {
    margin-top: var(--space-2);
    max-width: 20ch;
  }

  .result__grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
  }

  .result__facts {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-7);
  }

  .result__fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .result__fact dt {
    font-size: var(--text-sm);
    color: #9fb3d1;
  }

  .result__fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: #fff;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .result__offer-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--uncovered);
    margin-bottom: var(--space-4);
  }

  .flow__plan {
    width: 100%;
    max-width: 28rem;
  }

  /* The card is white, even though its section is the dark ground — so the
     site's "primary buttons invert on dark grounds" rule (meant for buttons
     sitting directly on navy) would otherwise turn this one white-on-white.
     Its true context is the white card, so it keeps normal primary styling. */
  .flow__plan :global(.btn--primary) {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  .flow__plan :global(.btn--primary:hover) {
    background: var(--navy-mid);
    border-color: var(--navy-mid);
  }

  .flow__alt {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .result__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    .flow__plan {
      max-width: 30rem;
    }
  }

  .linkish {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: #a9c4e4;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
