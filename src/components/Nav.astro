---
import Wordmark from './Wordmark.astro';
import { NAV_LINKS, ROUTES } from '../config/site.js';

const path = Astro.url.pathname;
---

<header class="nav">
  <div class="shell nav__inner">
    <Wordmark href={ROUTES.home} class="nav__brand" />
    <nav aria-label="Main">
      <ul class="nav__links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
    flex-wrap: wrap;
  }

  /* Typography lives in Wordmark. Only placement belongs here. */
  .nav__brand {
    padding-block: var(--space-3);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.4rem + 1.4vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .nav__links a:hover {
    color: var(--blue-ink);
  }

  .nav__links a[aria-current='page'] {
    color: var(--navy);
    box-shadow: inset 0 -2px 0 var(--navy);
  }

  @media (max-width: 420px) {
    .nav__links {
      gap: 0.625rem;
    }
    .nav__links a {
      font-size: var(--text-xs);
    }
  }
</style>
