---
import Page from '../layouts/Page.astro';
import { ALL_PLANS, PROGRAM_TERMS, isPlanSellable } from '../config/plans.js';
import {
  ROUTES,
  TCPA_CONSENT,
  SITE,
  DISCLOSURES,
  STATE_FILING_REQUIREMENT,
  surplusLinesNoticeFor,
  canSellIncomeProtection,
} from '../config/site.js';

const T = PROGRAM_TERMS;

// Plan data is needed client-side to render the summary for whichever tier the
// URL names, so it ships as JSON rather than being branched on at build time.
const planSummaries = ALL_PLANS.map((p) => ({
  id: p.id,
  name: p.name,
  priceMonthly: p.priceMonthly,
  monthlyBenefit: p.monthlyBenefit,
  totalLimit: p.totalLimit,
  installments: p.installments,
  incomeProtection: p.incomeProtection,
  purchasable: isPlanSellable(p),
}));

// The surplus lines notice is acknowledged separately from everything else
// wherever income protection is sold.
//
// Two independent things, deliberately not conflated:
//   noticeText    — there is wording to show. Currently DRAFT, unapproved.
//   surplusOk     — that wording has been approved and selling may proceed.
//
// The notice renders for review whenever text exists; selling is gated only on
// the approval flag. Text existing must never be mistaken for text being
// approved, which is exactly the mistake the previous single check invited.
//
// The buyer's state is not collected at checkout, so the per-state notice
// falls back to the default entry here. See OPEN-ITEMS.md — before selling
// opens, the state has to be captured explicitly rather than inferred.
const noticeText = surplusLinesNoticeFor(null);
const surplusOk = canSellIncomeProtection();
const surplusIsDraft = Boolean(noticeText) && !surplusOk;
---

<Page
  title="Checkout — My Income Secure"
  description="Complete your My Secure Life Series membership."
>
  <div class="checkout">
    {/* ---- Success ---- */}
    <section class="section section--tight" data-view="success" hidden>
      <div class="shell shell--form">
        <div class="status-badge status-badge--success" aria-hidden="true">&#10003;</div>
        <p class="eyebrow">You're enrolled</p>
        <h1>That's done.</h1>
        <p class="lead done__lead">
          Your membership is active and a receipt is on its way to your email.
          Keep it — it has your membership details on it.
        </p>
        <p class="done__next">
          Questions about your membership go to
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or {SITE.phone}.
        </p>
        <a class="btn btn--secondary" href={ROUTES.home}>Back to the site</a>
      </div>
    </section>

    {/* ---- Cancelled ---- */}
    <section class="section section--tight" data-view="cancelled" hidden>
      <div class="shell shell--form">
        <div class="status-badge status-badge--neutral" aria-hidden="true">&#8226;</div>
        <p class="eyebrow">Nothing was charged</p>
        <h1>You stopped before paying.</h1>
        <p class="lead done__lead">
          Your details are still here and your estimate is saved. Pick up
          wherever you left off.
        </p>
        <div class="done__actions">
          <a class="btn btn--primary" href={ROUTES.checkout}>Try again</a>
          <a class="link-quiet" href={ROUTES.plans}>Look at the tiers again</a>
        </div>
      </div>
    </section>

    {/* ---- The form ---- */}
    <section class="section section--tight section--sunken" data-view="form">
      <div class="shell checkout__shell">
        <div class="checkout__head">
          <p class="eyebrow">Step 3 of 3</p>
          <h1 class="checkout__title">Complete your membership</h1>
        </div>

        {/* Persistent through the whole step — nobody loses track of what they
            are buying. On desktop it sticks alongside the form rather than
            scrolling away above it. */}
        <aside class="summary" data-summary aria-label="Your selection">
          <div class="summary__row">
            <span class="summary__label">Plan</span>
            <span class="summary__value" data-summary-name>—</span>
          </div>
          <div class="summary__row">
            <span class="summary__label">Paid to you if you lose your job</span>
            <span class="summary__value" data-summary-benefit>—</span>
          </div>
          <p class="summary__terms" data-summary-terms hidden></p>
          <div class="summary__row summary__row--total">
            <span class="summary__label">You pay</span>
            <span class="summary__value" data-summary-price>—</span>
          </div>
          <p class="summary__gap" data-summary-gap hidden></p>
          <a class="summary__change" href={ROUTES.plans}>Change plan</a>
        </aside>

        <div class="checkout__body">
        <p class="notice" data-no-plan hidden>
          No plan selected yet.
          <a href={ROUTES.plans}>Pick a tier</a> and you will come straight back
          here.
        </p>

        {/* Reached when a tier is chosen before card payment is switched on.
            The summary above still shows exactly what was picked, so this
            confirms the choice rather than discarding it. */}
        <div class="pending" data-not-purchasable hidden>
          <h2 class="pending__head">Enrollment opens shortly.</h2>
          <p class="pending__body">
            Your tier and its figures are set out in the summary and they are
            final. Card payment is not switched on yet, so there is nothing to
            pay today.
          </p>
          <p class="pending__body">
            If you want to be told the moment it opens, email
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call
            {' '}{SITE.phone}.
          </p>
          <div class="pending__actions">
            <a class="btn btn--secondary" href={ROUTES.calculator}>
              Check my shortfall
            </a>
            <a class="link-quiet" href={ROUTES.plans}>Look at the other tiers</a>
          </div>
        </div>

        {/* Outside the form on purpose: while selling is gated off the form
            is hidden, and a notice nobody can see cannot be reviewed. */}
        {
          noticeText && (
            <div class="surplus" data-surplus-block>
              {surplusIsDraft && (
                <p class="surplus__flag">
                  Draft notice &mdash; not approved, and not any state's
                  prescribed wording. Shown for review only.
                </p>
              )}
              <label class="consent consent--required">
                <input type="checkbox" data-surplus disabled={!surplusOk} />
                <span class="consent__text">{noticeText}</span>
              </label>
            </div>
          )
        }

        <form class="checkout__form" data-checkout-form hidden novalidate>
          <div class="field">
            <label for="co-name">Full name</label>
            <input
              type="text"
              id="co-name"
              name="fullName"
              autocomplete="name"
              required
            />
          </div>

          <div class="field">
            <label for="co-email">Email</label>
            <input
              type="email"
              id="co-email"
              name="email"
              autocomplete="email"
              inputmode="email"
              required
            />
            <p class="hint">Your receipt and membership details go here.</p>
          </div>

          <div class="field">
            <label for="co-phone">Phone <span class="optional">optional</span></label>
            <input
              type="tel"
              id="co-phone"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
            />
            <p class="hint">
              Only needed if you want us to be able to call you about a claim.
            </p>
          </div>

          {/* Unchecked by default, and never a condition of purchase. */}
          <label class="consent">
            <input type="checkbox" data-consent />
            <span class="consent__text">{TCPA_CONSENT.text}</span>
          </label>

          <p class="checkout__filing" data-filing hidden>
            {STATE_FILING_REQUIREMENT}{' '}
            <a href={ROUTES.guide}>How to file in your state</a>
          </p>

          <button type="submit" class="btn btn--primary btn--block" data-submit>
            Continue to payment
          </button>

          <p class="checkout__error" data-error role="alert" hidden></p>

          <p class="checkout__legal">
            Payment is handled by Stripe. You will be taken there to enter your
            card, and returned here afterwards.
          </p>
        </form>
        </div>
      </div>
    </section>
  </div>
</Page>

<script type="application/json" id="co-plans" set:html={JSON.stringify(planSummaries)}
></script>
<script
  type="application/json"
  id="co-surplus"
  set:html={JSON.stringify({
    required: surplusOk,
    approved: surplusOk,
    version: DISCLOSURES.surplusLinesVersion,
    text: noticeText,
  })}
></script>
<script
  type="application/json"
  id="co-consent"
  set:html={JSON.stringify(TCPA_CONSENT)}
></script>

<script>
  import { findPlan, PROGRAM_TERMS } from '../config/plans.js';
  import { startCheckout } from '../lib/checkout.js';
  import { loadCalcResult, clearCalcResult } from '../lib/storage.js';
  import { money, price } from '../lib/format.js';
  import { track, EVENTS } from '../lib/analytics.js';

  const summaries = JSON.parse(document.getElementById('co-plans').textContent);
  const consentMeta = JSON.parse(
    document.getElementById('co-consent').textContent
  );
  const surplusMeta = JSON.parse(
    document.getElementById('co-surplus').textContent
  );

  const params = new URLSearchParams(window.location.search);
  const status = params.get('status');
  const view = (name) => document.querySelector(`[data-view="${name}"]`);

  // ---- Return trips from Stripe ----
  if (status === 'success') {
    view('form').hidden = true;
    view('success').hidden = false;
    track(EVENTS.PURCHASE, { planId: params.get('plan') || undefined });
    clearCalcResult();
  } else if (status === 'cancelled') {
    view('form').hidden = true;
    view('cancelled').hidden = false;
  } else {
    setupForm();
  }

  function setupForm() {
    const planId = params.get('plan');
    const summary = summaries.find((p) => p.id === planId);
    const plan = findPlan(planId);
    const form = document.querySelector('[data-checkout-form]');
    const noPlan = document.querySelector('[data-no-plan]');
    const errorEl = document.querySelector('[data-error]');

    if (!summary || !plan) {
      document.querySelector('[data-summary]').hidden = true;
      noPlan.hidden = false;
      return;
    }

    document.querySelector('[data-summary-name]').textContent =
      summary.name ?? 'Not yet named';
    // The benefit figure never appears without its total and its limit — a
    // bare "$666/mo" on the last screen before payment is the single easiest
    // place for someone to believe they are buying an ongoing income.
    const benefitEl = document.querySelector('[data-summary-benefit]');
    const termsEl = document.querySelector('[data-summary-terms]');
    if (summary.incomeProtection && typeof summary.monthlyBenefit === 'number') {
      // One display figure, and it is the total — same rule as the tier card.
      benefitEl.textContent = money(summary.totalLimit);
      termsEl.hidden = false;
      termsEl.textContent =
        `Paid as ${summary.installments} payments of ` +
        `${money(summary.monthlyBenefit)}, ` +
        `${PROGRAM_TERMS.installmentIntervalDays} days apart. The first comes ` +
        `${PROGRAM_TERMS.firstInstallmentDays} days after the job loss; each ` +
        `one after that only if you are still out of work. If you are back at ` +
        `work sooner, the rest are forfeited.`;
      document.querySelector('[data-filing]').hidden = false;
    } else {
      benefitEl.textContent = 'No income protection';
      termsEl.hidden = false;
      termsEl.textContent =
        'The base membership pays nothing if you lose your job.';
    }

    document.querySelector('[data-summary-price]').textContent =
      typeof summary.priceMonthly === 'number'
        ? `${price(summary.priceMonthly)}/mo`
        : '—';

    // Show the summary either way; only the form depends on being able to pay.
    if (summary.purchasable) {
      form.hidden = false;
    } else {
      document.querySelector('[data-not-purchasable]').hidden = false;
    }

    const estimate = loadCalcResult();
    if (estimate && estimate.monthlyGap > 0) {
      const gapEl = document.querySelector('[data-summary-gap]');
      gapEl.hidden = false;
      gapEl.textContent = `Against the ${money(estimate.monthlyGap)} monthly gap you calculated for ${estimate.stateName}.`;
    }

    track(EVENTS.CHECKOUT_START, {
      planId: plan.id,
      purchasable: summary.purchasable,
    });

    if (!summary.purchasable) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.hidden = true;

      const fullName = form.querySelector('#co-name').value.trim();
      const email = form.querySelector('#co-email').value.trim();
      const phone = form.querySelector('#co-phone').value.trim();
      const consentBox = form.querySelector('[data-consent]');
      const surplusBox = document.querySelector('[data-surplus]');

      if (!fullName) return show('Enter your full name.');
      if (!email || !email.includes('@')) return show('Enter a valid email address.');
      // A phone number may only be sent with express written consent.
      if (phone && !consentBox.checked) {
        return show(
          'To give a phone number, tick the consent box. Or clear the phone field — it is optional.'
        );
      }
      // Separate from the TCPA box and separately required: acknowledging the
      // surplus lines notice is a condition of enrolling in income protection,
      // where marketing consent never is.
      if (summary.incomeProtection && surplusMeta.required && !surplusBox?.checked) {
        return show('Please acknowledge the surplus lines notice to continue.');
      }

      const submit = form.querySelector('[data-submit]');
      submit.disabled = true;
      submit.textContent = 'Taking you to payment…';

      try {
        await startCheckout(plan, {
          contact: { fullName, email, phone: phone || null },
          consent: {
            given: consentBox.checked,
            textVersion: consentMeta.version,
            text: consentBox.checked ? consentMeta.text : null,
            timestamp: new Date().toISOString(),
          },
          surplusLines: surplusMeta.required
            ? {
                acknowledged: Boolean(surplusBox?.checked),
                textVersion: surplusMeta.version,
                timestamp: new Date().toISOString(),
              }
            : null,
          estimate,
        });
      } catch (error) {
        submit.disabled = false;
        submit.textContent = 'Continue to payment';
        show(error.message);
      }
    });

    function show(message) {
      errorEl.textContent = message;
      errorEl.hidden = false;
      errorEl.scrollIntoView({ block: 'nearest' });
    }
  }
</script>

<style>
  .checkout__title {
    margin-bottom: var(--space-5);
  }

  .checkout__shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .checkout__head {
    max-width: var(--width-form);
  }

  .summary {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glow);
    padding: var(--space-6) var(--space-5) var(--space-5);
    overflow: hidden;
  }

  /* A thin gradient rule at the top — the same flourish as the recommended
     plan card, because this is that same choice, carried through to payment. */
  .summary::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 4px;
    background: var(--gradient-brand);
  }

  /* One wrapper owns the form column so its children flow in order instead of
     stacking in a single grid cell. */
  .checkout__body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    max-width: var(--width-form);
  }

  @media (min-width: 940px) {
    .checkout__shell {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 23rem);
      column-gap: var(--space-8);
      grid-template-areas:
        'head    summary'
        'form    summary';
    }

    .checkout__head { grid-area: head; }
    .summary {
      grid-area: summary;
      position: sticky;
      top: var(--space-6);
    }
    .checkout__body { grid-area: form; }
  }

  .summary__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .summary__row--total {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-strong);
  }

  .summary__label {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .summary__value {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--navy);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .summary__row--total .summary__value {
    font-size: var(--text-xl);
  }

  .summary__gap {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .summary__change {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .optional {
    font-weight: 500;
    color: var(--ink-muted);
    text-transform: none;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-block: var(--space-5);
    padding: var(--space-4);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-alt);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .consent:hover {
    border-color: var(--blue);
  }

  .consent:has(input:checked) {
    border-color: var(--navy);
    box-shadow: 0 0 0 1px var(--navy);
  }

  .consent input {
    inline-size: 20px;
    block-size: 20px;
    margin-top: 3px;
    flex: none;
    accent-color: var(--navy);
  }

  .consent__text {
    font-size: var(--text-xs);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  /* Required, unlike the marketing consent above it, so it reads as part of
     the purchase rather than an optional extra. */
  .consent--required {
    border-color: var(--line-strong);
    background: var(--paper);
  }

  .consent--required .consent__text {
    color: var(--ink);
  }

  /* The draft flag has to be impossible to miss, and visually distinct from
     the notice it is labelling. */
  .surplus {
    border: 1.5px solid var(--uncovered-line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-flat);
  }

  .surplus__flag {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--uncovered-wash);
    border-bottom: 1px solid var(--uncovered-line);
    color: var(--uncovered-ink);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .surplus .consent {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .surplus input:disabled {
    cursor: not-allowed;
  }

  .checkout__filing {
    margin-block: var(--space-4);
    font-size: var(--text-xs);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  /* Sits directly under the benefit figure inside the summary, so the two
     cannot be separated by a layout change. */
  .summary__terms {
    margin-top: calc(var(--space-2) * -1);
    padding-bottom: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
  }

  .pending {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--blue-pale) 0%, var(--paper) 100%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }

  .pending__head {
    font-size: var(--text-xl);
  }

  .pending__body {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .pending__actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .checkout__error {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #a3231b;
  }

  .checkout__legal {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-align: center;
  }

  .notice {
    padding: var(--space-5);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 52px;
    block-size: 52px;
    border-radius: 50%;
    font-size: 1.375rem;
    font-weight: 800;
    margin-bottom: var(--space-4);
  }

  .status-badge--success {
    background: var(--covered-wash);
    color: var(--covered-ink);
    border: 2px solid var(--covered-line);
    box-shadow: 0 0 0 6px var(--covered-wash);
  }

  .status-badge--neutral {
    background: var(--paper-alt);
    color: var(--ink-muted);
    border: 2px solid var(--line-strong);
  }

  .done__lead {
    margin-block: var(--space-4);
  }

  .done__next {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-5);
  }

  .done__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
</style>
