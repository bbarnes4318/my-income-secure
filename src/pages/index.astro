---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import CoverageFlow from '../components/CoverageFlow.astro';
import Faq from '../components/Faq.astro';
import { PLANS, PROGRAM_TERMS, ELIGIBILITY_CRITERIA } from '../config/plans.js';
import { ROUTES, STATE_FILING_REQUIREMENT, URGENCY } from '../config/site.js';
import { money, price } from '../lib/format.js';

const cheapest = PLANS[0];
const largest = PLANS[PLANS.length - 1];
const T = PROGRAM_TERMS;

const faqs = [
  {
    q: 'What exactly is My Income Secure?',
    a: 'My Income Secure is a membership benefit program built around a fixed job-loss income protection benefit. Your membership tier determines the total benefit available under the program terms.',
  },
  {
    q: 'How much can I get?',
    a: `Income-protection tiers range from ${money(cheapest.totalLimit)} to ${money(largest.totalLimit)} total. Each tier pays its total in ${T.installments} installments, ${T.installmentIntervalDays} days apart, subject to the program terms.`,
  },
  {
    q: 'When does a claim become payable?',
    a: `A claim becomes admissible after ${T.claimThresholdDays} consecutive days unemployed. The first installment is scheduled ${T.firstInstallmentDays} days after the qualifying job loss.`,
  },
  {
    q: 'What happens when I go back to work?',
    a: 'Each installment after the first is paid only while you remain unemployed. Return to work before all installments are paid and the remaining installments are forfeited.',
  },
  {
    q: 'Do I still have to file for state unemployment?',
    a: STATE_FILING_REQUIREMENT,
    cta: { href: ROUTES.guide, label: 'Read the state filing guide' },
  },
  {
    q: 'Can I cancel?',
    a: `You can cancel. A full refund is available within ${T.refundWindowHours} hours of purchase if no benefits have been used.`,
  },
];
---

<Base
  title="My Income Secure — Protect the gap when a paycheck stops"
  description={`My Income Secure provides job-loss income protection through a membership benefit program, with plans from ${price(cheapest.priceMonthly)}/month and up to ${money(largest.totalLimit)} total.`}
>
  <div class="income-secure-home">
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={ROUTES.home} aria-label="My Income Secure home">
          <span class="brand__my">MY</span>
          <span class="brand__name">INCOME SECURE</span>
        </a>
        <a class="header-cta" href="#coverage-check">See my gap <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow">Job-loss income protection</p>
            <h1 id="hero-title">Your paycheck can stop overnight. Your bills don't.</h1>
            <p class="hero__lead">
              My Income Secure gives you a fixed cash benefit after a qualifying job loss —
              built to help with the gap between your state unemployment benefit and what your household still has to cover.
            </p>

            <div class="hero__offer" aria-label="Program pricing and maximum benefit">
              <div class="hero__offer-block">
                <span>FROM</span>
                <strong>{price(cheapest.priceMonthly)}</strong>
                <small>/ month</small>
              </div>
              <div class="hero__offer-rule" aria-hidden="true"></div>
              <div class="hero__offer-block hero__offer-block--right">
                <span>UP TO</span>
                <strong>{money(largest.totalLimit)}</strong>
                <small>total benefit</small>
              </div>
            </div>

            <div class="hero__cta-row">
              <a class="primary-cta" href="#coverage-check">
                Calculate my coverage gap <span aria-hidden="true">→</span>
              </a>
              <span class="hero__microcopy">Four short questions. A personalized number. No generic quote.</span>
            </div>

            <div class="hero__proofline">
              <span>Fixed cash benefit</span>
              <span>{T.installments} payments</span>
              <span>Paid to you</span>
            </div>
          </div>

          <div class="hero__visual" aria-hidden="true">
            <div class="visual-frame">
              <div class="visual-frame__top">
                <span>WHEN INCOME STOPS</span>
                <span>01</span>
              </div>

              <div class="visual-stack">
                <div class="visual-row visual-row--paycheck">
                  <span>PAYCHECK</span>
                  <strong>STOP</strong>
                </div>
                <div class="visual-gap">
                  <span>THE GAP</span>
                  <div class="visual-gap__line"></div>
                </div>
                <div class="visual-row visual-row--cover">
                  <span>PROTECTION</span>
                  <strong>CONTINUES</strong>
                </div>
              </div>

              <div class="visual-frame__bottom">
                <span>STATE BENEFIT</span>
                <span>+ MY INCOME SECURE</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bridge">
        <div class="bridge__inner">
          <div class="bridge__lead">
            <span class="section-tag">The problem</span>
            <h2>Most people don't know their real number until they have to live through it.</h2>
          </div>
          <div class="bridge__body">
            <p>State unemployment may replace part of your paycheck. Your housing, car, food, utilities and other monthly costs do not pause.</p>
            <p>So don't guess. Run the numbers using your state, your income and your actual monthly expenses.</p>
          </div>
        </div>
      </section>

      <section class="coverage-launch" id="coverage-check">
        <div class="coverage-launch__inner">
          <div class="coverage-launch__heading">
            <span class="section-tag">Your personalized number</span>
            <h2>Let's calculate the gap.</h2>
            <p>We use the existing state-benefit formulas, your income and the costs you enter. Then we show you one recommendation based on the result.</p>
          </div>
          <div class="coverage-launch__steps" aria-label="Coverage check steps">
            <span><b>01</b> State</span>
            <span><b>02</b> Income</span>
            <span><b>03</b> Expenses</span>
            <span><b>04</b> Eligibility</span>
          </div>
        </div>
      </section>

      <div class="coverage-shell">
        <CoverageFlow />
      </div>

      <section class="decision" aria-label="How the recommendation works">
        <div class="decision__inner">
          <div class="decision__intro">
            <span class="section-tag">After your result</span>
            <h2>No plan maze. One answer built from your number.</h2>
          </div>
          <div class="decision__steps">
            <div class="decision-step">
              <span>01</span>
              <strong>Your state benefit</strong>
              <p>Your estimated unemployment benefit gives us the starting point.</p>
            </div>
            <div class="decision-step">
              <span>02</span>
              <strong>Your monthly gap</strong>
              <p>Your expenses show what is still left to cover each month.</p>
            </div>
            <div class="decision-step">
              <span>03</span>
              <strong>Your recommendation</strong>
              <p>The system recommends the least-expensive protection tier that can close the calculated shortfall.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="facts">
        <div class="facts__inner">
          <div class="facts__heading">
            <span class="section-tag">Know what you're buying</span>
            <h2>Simple rules. Clear numbers. Nothing important hidden.</h2>
          </div>
          <div class="facts__grid">
            <article>
              <span>PAYMENT</span>
              <strong>{T.installments} installments</strong>
              <p>A qualifying claim is paid in {T.installments} installments, {T.installmentIntervalDays} days apart.</p>
            </article>
            <article>
              <span>TIMING</span>
              <strong>Set it up before the loss</strong>
              <p>{URGENCY}</p>
            </article>
            <article>
              <span>REFUND</span>
              <strong>{T.refundWindowHours}-hour window</strong>
              <p>A full refund is available within the stated window when no benefits have been used.</p>
            </article>
            <article>
              <span>STATE FILING</span>
              <strong>Still required</strong>
              <p>{STATE_FILING_REQUIREMENT}</p>
            </article>
          </div>
        </div>
      </section>

      <section class="eligibility">
        <div class="eligibility__inner">
          <div class="eligibility__heading">
            <span class="section-tag">Before enrollment</span>
            <h2>See the rules before you reach the decision.</h2>
            <p>These are the same attestations used in the guided flow.</p>
          </div>
          <div class="eligibility__list">
            {ELIGIBILITY_CRITERIA.map((criterion, i) => (
              <div class="eligibility__item">
                <span class="eligibility__num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{criterion.label}</strong>
                  {criterion.detail && <p>{criterion.detail}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="faq-section__inner">
          <div class="faq-section__heading">
            <span class="section-tag">The questions that matter</span>
            <h2>Read this before you decide.</h2>
          </div>
          <div class="faq-section__wrap">
            <Faq items={faqs} />
          </div>
        </div>
      </section>

      <section class="close">
        <div class="close__inner">
          <span class="section-tag">Start with your number</span>
          <h2>Know your gap before you need to close it.</h2>
          <p>Run the coverage check and see what your own state benefit and monthly costs look like together.</p>
          <a class="primary-cta primary-cta--light" href="#coverage-check">Calculate my coverage gap <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <Footer minimal />
  </div>
</Base>

<style>
  .income-secure-home {
    --black: #11110f;
    --ink: #1b1a17;
    --muted: #69665e;
    --paper: #fbf8f1;
    --paper-2: #f1ede3;
    --line: #d7d1c6;
    --red: #c94d39;
    --red-dark: #a73d2d;
    --blue: #2351c8;
    --acid: #d8ef68;
    --white: #ffffff;
    background: var(--paper);
    color: var(--ink);
    overflow-x: clip;
  }

  .income-secure-home,
  .income-secure-home * {
    box-sizing: border-box;
  }

  .income-secure-home a {
    color: inherit;
  }

  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    width: min(1360px, calc(100% - 44px));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    letter-spacing: -.03em;
  }

  .brand__my {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .12em;
    color: var(--red);
  }

  .brand__name {
    font-size: 20px;
    font-weight: 900;
    color: var(--black);
  }

  .header-cta {
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    color: var(--blue) !important;
  }

  .hero {
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    width: min(1360px, calc(100% - 44px));
    min-height: min(800px, calc(100vh - 77px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(400px, .94fr);
    gap: clamp(40px, 6vw, 100px);
    align-items: stretch;
  }

  .hero__copy {
    align-self: center;
    padding: 80px 0;
  }

  .eyebrow,
  .section-tag {
    display: inline-block;
    margin: 0 0 20px;
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--red-dark);
  }

  .hero h1 {
    margin: 0;
    max-width: 9ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(62px, 7.3vw, 118px);
    line-height: .88;
    letter-spacing: -.06em;
    color: var(--black);
    font-weight: 700;
  }

  .hero__lead {
    max-width: 700px;
    margin-top: 32px;
    font-size: clamp(18px, 1.35vw, 22px);
    line-height: 1.48;
    color: #403f3a;
  }

  .hero__offer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 22px;
    width: min(620px, 100%);
    margin-top: 34px;
    padding: 20px 22px;
    background: var(--black);
    color: var(--white);
  }

  .hero__offer-block {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
  }

  .hero__offer-block span {
    flex: 0 0 100%;
    margin-bottom: 4px;
    font-size: 10px;
    letter-spacing: .16em;
    font-weight: 800;
    color: #a9a69d;
  }

  .hero__offer-block strong {
    font-size: 32px;
    line-height: 1;
    letter-spacing: -.035em;
  }

  .hero__offer-block small {
    font-size: 12px;
    color: #c3c0b8;
  }

  .hero__offer-block--right {
    justify-content: flex-end;
    text-align: right;
  }

  .hero__offer-rule {
    width: 1px;
    height: 54px;
    background: rgba(255,255,255,.18);
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 20px;
    margin-top: 26px;
  }

  .primary-cta {
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 28px;
    background: var(--red);
    color: white !important;
    text-decoration: none;
    font-size: 16px;
    font-weight: 900;
    border: 1px solid var(--red);
    transition: transform .16s ease, background-color .16s ease;
  }

  .primary-cta:hover {
    background: var(--red-dark);
    transform: translateY(-1px);
  }

  .hero__microcopy {
    max-width: 280px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .hero__proofline {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 26px;
    font-size: 12px;
    font-weight: 800;
    color: #45433e;
  }

  .hero__proofline span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero__proofline span::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--red);
    flex: 0 0 auto;
  }

  .hero__visual {
    padding: 28px 0 28px 0;
  }

  .visual-frame {
    position: relative;
    height: 100%;
    min-height: 620px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--black);
    color: var(--white);
    padding: 28px;
    overflow: hidden;
  }

  .visual-frame::before {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    right: -230px;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 50%;
    box-shadow: 0 0 0 80px rgba(255,255,255,.025), 0 0 0 160px rgba(255,255,255,.018);
  }

  .visual-frame__top,
  .visual-frame__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .15em;
    color: #aaa69d;
  }

  .visual-stack {
    position: relative;
    z-index: 1;
    align-self: center;
    display: grid;
    gap: 16px;
    padding: 30px 0;
  }

  .visual-row {
    border: 1px solid rgba(255,255,255,.18);
    padding: 28px;
  }

  .visual-row span {
    display: block;
    margin-bottom: 10px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
    color: #aaa69d;
  }

  .visual-row strong {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(42px, 4vw, 64px);
    line-height: .9;
    letter-spacing: -.05em;
  }

  .visual-row--paycheck strong {
    color: var(--acid);
  }

  .visual-row--cover {
    margin-left: 14%;
    background: var(--red);
    border-color: var(--red);
  }

  .visual-row--cover span {
    color: #f8d8cf;
  }

  .visual-gap {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 2px 20px;
    color: #cac6bc;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .17em;
  }

  .visual-gap__line {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, rgba(216,239,104,.85), rgba(216,239,104,.1), rgba(255,255,255,.25));
  }

  .bridge {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .bridge__inner {
    width: min(1200px, calc(100% - 44px));
    margin: 0 auto;
    padding: 100px 0;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, .7fr);
    gap: clamp(50px, 10vw, 150px);
    align-items: start;
  }

  .bridge h2,
  .coverage-launch h2,
  .decision h2,
  .facts h2,
  .eligibility h2,
  .faq-section h2,
  .close h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: .98;
  }

  .bridge h2 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(42px, 5vw, 72px);
  }

  .bridge__body {
    display: grid;
    gap: 22px;
    padding-top: 12px;
  }

  .bridge__body p {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: #4d4a43;
  }

  .coverage-launch {
    background: var(--black);
    color: white;
    border-bottom: 1px solid #2a2926;
  }

  .coverage-launch__inner {
    width: min(1200px, calc(100% - 44px));
    margin: 0 auto;
    padding: 92px 0 56px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, .65fr);
    gap: 50px;
    align-items: end;
  }

  .coverage-launch__heading h2 {
    margin: 0;
    max-width: 9ch;
    font-size: clamp(52px, 5.8vw, 86px);
    color: white;
  }

  .coverage-launch__heading p {
    margin: 22px 0 0;
    max-width: 58ch;
    font-size: 17px;
    line-height: 1.55;
    color: #bcb8af;
  }

  .coverage-launch__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(255,255,255,.16);
    border-left: 1px solid rgba(255,255,255,.16);
  }

  .coverage-launch__steps span {
    min-height: 70px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    border-right: 1px solid rgba(255,255,255,.16);
    border-bottom: 1px solid rgba(255,255,255,.16);
    font-size: 12px;
    font-weight: 800;
    color: #dedad1;
  }

  .coverage-launch__steps b {
    color: var(--acid);
    font-size: 11px;
    letter-spacing: .06em;
  }

  .coverage-shell {
    background: var(--black);
    padding-bottom: 100px;
  }

  .coverage-shell :global(.coverage) {
    width: min(1200px, calc(100% - 44px));
    margin: 0 auto;
    background: #f4f1ea;
    border: 0;
    padding: 62px clamp(24px, 4vw, 64px);
  }

  .coverage-shell :global(.coverage__intro) {
    display: none;
  }

  .coverage-shell :global(.coverage__shell) {
    margin-top: 0;
    padding: 0;
  }

  .coverage-shell :global(.progress) {
    max-width: none;
    margin-bottom: 34px;
  }

  .coverage-shell :global(.progress__label) {
    color: #5a574f;
  }

  .coverage-shell :global(.progress__name) {
    color: var(--red-dark);
  }

  .coverage-shell :global(.fstep) {
    max-width: 760px;
  }

  .coverage-shell :global(.fstep__q) {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 4vw, 56px);
    line-height: .98;
    letter-spacing: -.035em;
    color: var(--black);
  }

  .coverage-shell :global(.fstep__why) {
    font-size: 15px;
    line-height: 1.5;
    color: #6b675f;
  }

  .coverage-shell :global(select),
  .coverage-shell :global(input[type='number']) {
    background: #fff;
    border-color: #c7c1b7;
    border-radius: 0;
    min-height: 58px;
  }

  .coverage-shell :global(label) {
    color: var(--black);
  }

  .coverage-shell :global(.input-money > span) {
    border-radius: 0;
    background: #ece7dc;
    border-color: #c7c1b7;
  }

  .coverage-shell :global(.btn) {
    border-radius: 0;
    box-shadow: none;
  }

  .coverage-shell :global(.btn--primary) {
    background: var(--red);
    border-color: var(--red);
  }

  .coverage-shell :global(.btn--primary:hover) {
    background: var(--red-dark);
    border-color: var(--red-dark);
  }

  .coverage-shell :global(.btn--secondary) {
    background: transparent;
    border-color: #bfb8ac;
  }

  .coverage-shell :global(.flow__actions) {
    gap: 12px;
  }

  .coverage-shell :global(.check) {
    border-radius: 0;
    background: white;
    border-color: #d0c9be;
  }

  .coverage-shell :global(.check:has(input:checked)) {
    background: #f5eadf;
    border-color: var(--red);
  }

  .coverage-shell :global(.flow__result) {
    width: min(1200px, calc(100% - 44px));
    margin: 0 auto;
    padding: 0;
    background: var(--black);
  }

  .coverage-shell :global(.flow__result > .shell) {
    padding: 78px clamp(24px, 4vw, 64px);
  }

  .coverage-shell :global(.result__head h2) {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(48px, 5vw, 76px);
    letter-spacing: -.045em;
  }

  .coverage-shell :global(.result__fact dt) {
    color: #8e8a80;
  }

  .coverage-shell :global(.result__fact dd) {
    color: white;
  }

  .coverage-shell :global(.result__offer-label) {
    color: #e5c0b8;
  }

  .coverage-shell :global(.plan) {
    border-radius: 0;
    box-shadow: none;
  }

  .coverage-shell :global(.plan--recommended) {
    border-radius: 0;
    border: 2px solid var(--red);
    box-shadow: none;
  }

  .coverage-shell :global(.plan__flag) {
    border-radius: 0;
    background: var(--red);
  }

