---
import Page from '../layouts/Page.astro';
import CoverageFlow from '../components/CoverageFlow.astro';
import Faq from '../components/Faq.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { ROUTES, URGENCY, STATE_FILING_REQUIREMENT } from '../config/site.js';
import { ELIGIBILITY_CRITERIA, PROGRAM_TERMS, PLANS } from '../config/plans.js';
import { money, price } from '../lib/format.js';

const T = PROGRAM_TERMS;
const cheapest = PLANS[0];
const largest = PLANS[PLANS.length - 1];

const facts = [
  {
    kicker: `${T.installments} payments`,
    title: `${money(largest.monthlyBenefit)} at a time`,
    body: `A qualifying claim is paid in ${T.installments} installments, ${T.installmentIntervalDays} days apart.`,
  },
  {
    kicker: 'A fixed benefit',
    title: `Up to ${money(largest.totalLimit)} total`,
    body: 'Your tier determines the total benefit. It is not an open-ended monthly promise.',
  },
  {
    kicker: 'Before you need it',
    title: 'Set it up before the job loss',
    body: URGENCY,
  },
];

const faqs = [
  {
    q: 'What exactly am I buying?',
    a:
      'My Income Secure is a membership benefit program. The membership itself is not an insurance policy. The income protection benefit within the program is insured separately and has its own eligibility, claim and payment conditions.',
  },
  {
    q: 'How much could I receive?',
    a:
      `Your selected tier determines the total benefit, from ${money(cheapest.totalLimit)} to ${money(largest.totalLimit)}. Each income-protection tier pays that total in ${T.installments} installments.`,
  },
  {
    q: 'When does a claim become payable?',
    a:
      `A claim becomes admissible after ${T.claimThresholdDays} consecutive days unemployed. The first installment is scheduled ${T.firstInstallmentDays} days after the qualifying job loss.`,
  },
  {
    q: 'Do I still need to file for state unemployment?',
    a: STATE_FILING_REQUIREMENT,
    cta: { href: ROUTES.guide, label: 'Read the filing guide' },
  },
  {
    q: 'What happens if I go back to work?',
    a:
      `Each installment after the first is paid only while you remain unemployed. Return to work before all installments are paid, and the remaining installments are forfeited.`,
  },
  {
    q: 'Can I cancel?',
    a:
      `You can cancel. A full refund is available within ${T.refundWindowHours} hours of purchase provided no benefits have been used.`,
  },
];
---

<Page
  title="Protect the gap between your paycheck and your bills — My Income Secure"
  description={`My Income Secure provides up to ${money(largest.totalLimit)} in job-loss income protection. Plans start at ${price(cheapest.priceMonthly)}/month.`}
  landing
>
  <section class="hero">
    <div class="shell hero__shell">
      <div class="hero__copy">
        <p class="hero__eyebrow">Job-loss income protection</p>
        <h1>Protect the gap between your paycheck and your bills.</h1>
        <p class="hero__lead">
          My Income Secure is a membership that pays a fixed cash benefit after
          a qualifying job loss — directly to you while you look for your next job.
        </p>

        <div class="hero__offer">
          <div class="hero__offer-price">
            <span>Plans from</span>
            <strong>{price(cheapest.priceMonthly)}</strong>
            <span>/month</span>
          </div>
          <div class="hero__offer-divider" aria-hidden="true"></div>
          <div class="hero__offer-max">
            <strong>Up to {money(largest.totalLimit)}</strong>
            <span>total job-loss benefit</span>
          </div>
        </div>

        <div class="hero__actions">
          <a class="btn btn--primary" href="#coverage-check">Calculate my coverage gap <span aria-hidden="true">→</span></a>
          <span class="hero__action-note">See your estimated gap before you enroll.</span>
        </div>

        <div class="hero__proof" aria-label="Program highlights">
          <span>Fixed cash benefit</span>
          <span>{T.installments} installments</span>
          <span>Paid directly to you</span>
        </div>
      </div>

      <div class="hero__visual">
        <ImageSlot name="home-hero" ratio="4 / 5" />
        <div class="hero__visual-card" aria-label="How the protection works">
          <span class="hero__visual-kicker">The simple idea</span>
          <strong>Your state benefit<br />may not cover the full month.</strong>
          <span>We calculate the gap, then show you one protection amount built around it.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt facts" aria-label="How the benefit works">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <p class="eyebrow">How the protection works</p>
        <h2>A fixed benefit. A defined amount. No guesswork about the tier.</h2>
      </div>

      <div class="facts__grid">
        {facts.map((fact, i) => (
          <article class="fact">
            <span class="fact__index">0{i + 1}</span>
            <p class="fact__kicker">{fact.kicker}</p>
            <h3>{fact.title}</h3>
            <p>{fact.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CoverageFlow />

  <section class="section eligibility">
    <div class="shell eligibility__shell">
      <div class="eligibility__intro">
        <p class="eyebrow">Before you enroll</p>
        <h2>Eligibility is straightforward and visible up front.</h2>
        <p class="lead">
          The enrollment attestations are shown before the recommendation so you
          can see exactly what the program requires before moving toward checkout.
        </p>
      </div>

      <div class="eligibility__list">
        {ELIGIBILITY_CRITERIA.map((criterion, i) => (
          <div class="eligibility__item">
            <span class="eligibility__number">{i + 1}</span>
            <div>
              <strong>{criterion.label}</strong>
              {criterion.detail && <p>{criterion.detail}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--warm faq-section">
    <div class="shell faq-section__shell">
      <div class="section-heading">
        <p class="eyebrow">Before you decide</p>
        <h2>The answers people usually want before enrolling.</h2>
      </div>
      <div class="faq-wrap">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <section class="section section--deep close">
    <div class="shell close__shell">
      <div>
        <p class="eyebrow">Get your number</p>
        <h2>Find out what your paycheck could leave uncovered.</h2>
        <p class="lead">
          Four short questions. Your state's formula. Your monthly expenses.
          One recommended protection amount.
        </p>
      </div>
      <div class="close__cta">
        <div class="close__price">
          <strong>Plans from {price(cheapest.priceMonthly)}/month</strong>
          <span>Up to {money(largest.totalLimit)} total benefit</span>
        </div>
        <a class="btn btn--primary" href="#coverage-check">Calculate my coverage gap <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Page>

<style>
  .hero {
    background:
      radial-gradient(circle at 76% 28%, rgba(46, 127, 196, 0.11), transparent 30%),
      linear-gradient(180deg, var(--blue-pale) 0%, #f6f9fc 100%);
    border-bottom: 1px solid var(--line);
    overflow: clip;
  }

  .hero__shell {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(3rem, 4vw, 5.5rem);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--blue-ink);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 11ch;
    font-size: clamp(2.65rem, 4.8vw, 4.9rem);
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  .hero__lead {
    max-width: 56ch;
    margin-top: var(--space-5);
    font-size: clamp(1.05rem, 1vw + 0.7rem, 1.35rem);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .hero__offer {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
    max-width: 38rem;
    padding: 1rem 1.125rem;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
  }

  .hero__offer-price,
  .hero__offer-max {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .hero__offer-price span,
  .hero__offer-max span {
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  .hero__offer-price strong,
  .hero__offer-max strong {
    color: var(--navy);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
  }

  .hero__offer-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-strong);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .hero__action-note {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    max-width: 26ch;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: var(--space-5);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .hero__proof span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__proof span::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--covered-ink);
  }

  .hero__visual {
    position: relative;
    min-width: 0;
  }

  .hero__visual :global(.slot) {
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 24rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    overflow: hidden;
  }

  .hero__visual-card {
    position: absolute;
    left: -1rem;
    bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: min(78%, 22rem);
    padding: 1rem 1.125rem;
    background: rgba(14, 33, 67, 0.96);
    color: #fff;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-float);
  }

  .hero__visual-kicker {
    color: var(--uncovered);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__visual-card strong {
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .hero__visual-card > span:last-child {
    color: #c2d0e4;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .section-heading {
    max-width: 46rem;
  }

  .section-heading--wide {
    max-width: 58rem;
  }

  .section-heading h2 {
    max-width: 22ch;
  }

  .section-heading .eyebrow {
    margin-bottom: var(--space-2);
  }

  .facts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: var(--space-7);
    border-top: 1px solid var(--line-strong);
  }

  .fact {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .fact__index {
    grid-row: 1 / span 3;
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  .fact__kicker {
    color: var(--blue-ink);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fact h3 {
    margin-top: 0.2rem;
    color: var(--navy);
  }

  .fact > p:last-child {
    margin-top: 0.35rem;
    color: var(--ink-muted);
    max-width: 52ch;
    font-size: var(--text-sm);
  }

  .eligibility {
    background: var(--paper);
  }

  .eligibility__shell {
    display: grid;
    gap: var(--space-8);
  }

  .eligibility__intro .lead {
    margin-top: var(--space-4);
  }

  .eligibility__list {
    border-top: 1px solid var(--line-strong);
  }

  .eligibility__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .eligibility__number {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--navy);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .eligibility__item strong {
    display: block;
    color: var(--navy);
    line-height: 1.35;
  }

  .eligibility__item p {
    margin-top: 0.35rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .faq-section__shell {
    max-width: 1050px;
  }

  .faq-wrap {
    max-width: 60rem;
    margin-top: var(--space-6);
  }

  .close__shell {
    display: grid;
    gap: var(--space-7);
    align-items: end;
  }

  .close h2 {
    max-width: 15ch;
  }

  .close .lead {
    margin-top: var(--space-4);
  }

  .close__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .close__price {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .close__price strong {
    color: #fff;
    font-size: var(--text-lg);
  }

  .close__price span {
    color: #b9c9df;
    font-size: var(--text-sm);
  }

  @media (min-width: 760px) {
    .hero__shell {
      grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.72fr);
      align-items: center;
      min-height: min(760px, calc(100vh - 4.5rem));
    }

    .hero__visual-card {
      left: -2rem;
    }

    .facts__grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--space-7);
    }

    .fact {
      border-right: 1px solid var(--line-strong);
      padding-right: var(--space-6);
    }

    .fact:last-child {
      border-right: 0;
    }

    .eligibility__shell {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: start;
    }

    .close__shell {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 759px) {
    .hero__visual {
      order: -1;
    }

    .hero__visual :global(.slot) {
      aspect-ratio: 16 / 10;
      min-height: 0;
      border-radius: 0;
    }

    .hero__visual-card {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      width: auto;
    }

    .hero h1 {
      max-width: 13ch;
    }

    .hero__offer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      align-items: stretch;
    }

    .hero__offer-divider {
      display: none;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
