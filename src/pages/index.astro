---
// The homepage is a single-purpose funnel, not an informational page. One
// offer, surfaced only after the visitor answers four questions about their
// own situation. Everything that would compete with that — a plan grid, a
// second calculator demo, site navigation — has been removed. The full plan
// ladder, the standalone calculator, and the filing guide are untouched and
// still reachable directly; they are just no longer links off this page.
import Page from '../layouts/Page.astro';
import CoverageFlow from '../components/CoverageFlow.astro';
import Faq from '../components/Faq.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { ROUTES, URGENCY } from '../config/site.js';
import { PROGRAM_TERMS, PLANS } from '../config/plans.js';
import { money, price } from '../lib/format.js';

const T = PROGRAM_TERMS;
const cheapest = PLANS[0];
const largest = PLANS[PLANS.length - 1];

// Top four objections only — the ones that block a "yes" at this exact moment,
// not the full reference list. The rest still lives nowhere else on the site
// because it never did; these were always drawn from PROGRAM_TERMS.
const faqs = [
  {
    q: 'How is this different from insurance?',
    a:
      'It is a membership benefit program, not an insurance product. You are not ' +
      'buying a policy and there is no insurer indemnifying a loss. You hold a ' +
      'membership that pays a fixed benefit if you lose your job.',
  },
  {
    q: 'Do I still need to file for state unemployment?',
    a:
      'Yes. A claim requires you to be eligible for and approved to receive ' +
      'state unemployment benefits for the same period you are claiming. If you ' +
      'never file with your state, there is nothing here to pay out on.',
    cta: { href: ROUTES.guide, label: 'Read the filing guide' },
  },
  {
    q: 'How do I cancel, and can I get a refund?',
    a:
      `You can cancel at any time. A full refund is available within ` +
      `${T.refundWindowHours} hours of purchase, provided no benefits have ` +
      'been used. There is no refund after that window.',
  },
  {
    q: 'What if I quit rather than getting laid off?',
    a:
      'The program exists for job loss you did not choose. Resigning ' +
      'voluntarily is not the situation it is built to cover.',
  },
];
---

<Page
  title="If you're laid off, get up to $6,000 while you find work — My Income Secure"
  description="See what your state pays, then get one plan sized to close the gap — starting at $24.99/month."
  landing
>
  <section class="hero">
    <div class="shell hero__shell">
      <div class="hero__text">
        <p class="hero__eyebrow">Job-loss income protection</p>
        <h1>If you're laid off, get up to {money(largest.totalLimit)} while you find work.</h1>
        <p class="hero__specifics">
          Plans start at {price(cheapest.priceMonthly)}/month, paid to you in
          {T.installments} installments if you lose your job.
        </p>
        <p class="hero__objection">
          <span>No spam calls.</span>
          <span>No medical exam.</span>
          <span>Cancel anytime.</span>
        </p>
      </div>
      <div class="hero__figure">
        <ImageSlot name="home-hero" ratio="4 / 5" />
      </div>
    </div>

    <CoverageFlow />
  </section>

  {/* Tight, in order: how it pays out, terms, four-question FAQ, close. Once
      a result exists, FAQ and close are cut entirely (repeats of content the
      visitor already scrolled past) and "how it pays out" collapses to one
      line — only the payout mechanics and the terms stay relevant. See
      CoverageFlow's paint()/restart handlers, which toggle these. */}
  <section class="section section--tight payout">
    <div class="shell">
      <h2>How it pays out</h2>
      <div class="payout__stats" data-payout-full>
        <div class="payout__stat">
          <span class="payout__value">{T.installments}</span>
          <span class="payout__label">installments, {T.installmentIntervalDays} days apart</span>
        </div>
        <div class="payout__stat">
          <span class="payout__value">{T.firstInstallmentDays} days</span>
          <span class="payout__label">after you lose your job to the first payment</span>
        </div>
        <div class="payout__stat">
          <span class="payout__value">Stops</span>
          <span class="payout__label">the moment you're back at work</span>
        </div>
      </div>
      <p class="payout__condensed" data-payout-condensed hidden>
        Paid in {T.installments} installments, {T.installmentIntervalDays} days
        apart &mdash; stops the moment you're back at work.
      </p>
    </div>
  </section>

  <section class="section section--tight section--alt terms">
    <div class="shell">
      <h2>The terms, plainly</h2>
      <ul class="terms__list">
        <li>
          A claim becomes admissible after {T.claimThresholdDays} consecutive
          days unemployed.
        </li>
        <li>
          You must be eligible for and approved to receive state unemployment
          benefits for the same period &mdash;
          <a href={ROUTES.guide}>filing is part of it</a>.
        </li>
        <li>
          Each installment after the first is paid only if you're still
          unemployed; the rest are forfeited once you're re-employed.
        </li>
        <li>
          A full refund is available within {T.refundWindowHours} hours of
          purchase if no benefits have been used.
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight section--warm" data-faq-section>
    <div class="shell">
      <h2>Before you buy</h2>
      <div class="faq-wrap">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <section class="section close" data-close-section>
    <div class="shell">
      <h2>You cannot buy this once the job is already gone.</h2>
      <p class="lead close__lead">{URGENCY}</p>
      <a class="btn btn--primary" href="#coverage-check">See what I'd get &rarr;</a>
    </div>
  </section>
</Page>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 100% at 85% -10%, rgba(46, 127, 196, 0.16) 0%, transparent 55%),
      radial-gradient(90% 90% at -5% 110%, rgba(92, 138, 118, 0.14) 0%, transparent 60%),
      linear-gradient(178deg, var(--blue-pale) 0%, var(--surface-sunken) 100%);
    padding-block: var(--pad-tight) 0;
    overflow: hidden;
    transition: padding-block 0.15s ease;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    padding: 0.375rem 0.875rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--navy);
    box-shadow: var(--shadow-flat);
    margin-bottom: var(--space-4);
  }

  .hero__eyebrow::before {
    content: '';
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--covered);
    flex: none;
  }

  /* Once the visitor has answered the first question, the full hero has done
     its job — collapse it to a single compact line so the active step (which
     only grows from here) has room to sit above the fold. */
  .hero.hero--compact {
    padding-block: var(--space-3) 0;
  }

  .hero.hero--compact .hero__eyebrow,
  .hero.hero--compact .hero__specifics,
  .hero.hero--compact .hero__objection,
  .hero.hero--compact .hero__figure {
    display: none;
  }

  .hero.hero--compact .hero__shell {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .hero.hero--compact h1 {
    font-size: var(--text-base);
    font-weight: 700;
    max-width: none;
    letter-spacing: normal;
  }

  .hero__shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    max-width: 20ch;
  }

  .hero__specifics {
    max-width: 42ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--ink);
  }

  .hero__objection {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .hero__objection span {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--covered-ink);
    background: var(--covered-wash);
    border: 1px solid var(--covered-line);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.75rem 0.3rem 0.6rem;
  }

  .hero__objection span::before {
    content: '\2713';
    font-size: 0.8em;
    font-weight: 800;
  }

  .hero__figure {
    display: none;
  }

  @media (min-width: 780px) {
    .hero__shell {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-8);
    }

    .hero__figure {
      display: block;
    }

    .hero__figure :global(.slot) {
      max-height: 18rem;
      margin-inline: auto;
    }
  }

  /* --- How it pays out --- */
  .payout__stats {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .payout__stat {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .payout__value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--navy);
  }

  .payout__label {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: 26ch;
  }

  .payout__condensed {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    color: var(--ink);
    max-width: var(--measure);
  }

  @media (min-width: 700px) {
    .payout__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Terms --- */
  .terms__list {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .terms__list li {
    padding: var(--space-3) var(--space-4);
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 3px solid var(--blue);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    box-shadow: var(--shadow-flat);
  }

  /* --- FAQ --- */
  .faq-wrap {
    margin-top: var(--space-5);
    max-width: var(--measure);
  }

  /* --- Close --- */
  .close__lead {
    margin-block: var(--space-4) var(--space-6);
    max-width: var(--measure);
  }
</style>
