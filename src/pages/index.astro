---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { PLANS, PROGRAM_TERMS, ELIGIBILITY_CRITERIA } from '../config/plans.js';
import { ROUTES, STATE_FILING_REQUIREMENT, URGENCY } from '../config/site.js';
import { money, price } from '../lib/format.js';

const cheapest = PLANS[0];
const largest = PLANS[PLANS.length - 1];
const T = PROGRAM_TERMS;

const faqs = [
  {
    q: 'What exactly is My Income Secure?',
    a: 'My Income Secure is a membership benefit program built around a fixed job-loss income protection benefit. Your membership tier determines the total benefit available under the program terms.',
  },
  {
    q: 'How much can I receive?',
    a: `Income-protection tiers range from ${money(cheapest.totalLimit)} to ${money(largest.totalLimit)} total. Each tier pays its total in ${T.installments} installments, ${T.installmentIntervalDays} days apart, subject to the program terms.`,
  },
  {
    q: 'When can a claim be made?',
    a: `A claim becomes admissible after ${T.claimThresholdDays} consecutive days unemployed. The first installment is scheduled ${T.firstInstallmentDays} days after the qualifying job loss.`,
  },
  {
    q: 'What happens when I go back to work?',
    a: 'Each installment after the first is paid only while you remain unemployed. Return to work before all installments are paid and the remaining installments are forfeited.',
  },
  {
    q: 'Do I still have to file for state unemployment?',
    a: STATE_FILING_REQUIREMENT,
    cta: { href: ROUTES.guide, label: 'Read the state filing guide' },
  },
  {
    q: 'Can I cancel?',
    a: `You can cancel. A full refund is available within ${T.refundWindowHours} hours of purchase if no benefits have been used.`,
  },
];
---

<Base
  title="My Income Secure — Protect the paycheck your household depends on"
  description={`My Income Secure is a membership benefit program providing job-loss income protection from ${price(cheapest.priceMonthly)}/month, with tiers up to ${money(largest.totalLimit)} total.`}
>
  <div class="mis">
    <header class="header">
      <div class="header__inner">
        <a class="brand" href={ROUTES.home} aria-label="My Income Secure home">
          <span class="brand__mark">MIS</span>
          <span class="brand__text"><b>My Income Secure</b><small>Job-loss income protection</small></span>
        </a>
        <a class="header__cta" href="#coverage-check">See my gap <span>→</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow"><i></i> Income protection before you need it</p>
            <h1>Your paycheck can disappear. Your bills won't.</h1>
            <p class="hero__lead">My Income Secure is a membership benefit program designed to help with the cash-flow gap after a qualifying job loss — using a fixed benefit paid directly to you.</p>

            <div class="hero__offer">
              <div><span>STARTING AT</span><strong>{price(cheapest.priceMonthly)}</strong><small>/ month</small></div>
              <div class="hero__offer-line"></div>
              <div><span>UP TO</span><strong>{money(largest.totalLimit)}</strong><small>total benefit</small></div>
            </div>

            <a class="hero__cta" href="#coverage-check">See my coverage gap <span>→</span></a>
            <p class="hero__micro">Free calculation · 4 short steps · No phone number required</p>

            <div class="hero__bullets">
              <span><b>✓</b> Fixed cash benefit</span>
              <span><b>✓</b> Paid in {T.installments} installments</span>
              <span><b>✓</b> Paid directly to you</span>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="visual-header"><span>PAYCHECK INTERRUPTED</span><b>YOUR GAP</b></div>
            <div class="visual-body">
              <div class="visual-line visual-line--full"><span>PAYCHECK</span><i></i><em>100%</em></div>
              <div class="visual-label">Then your paycheck stops</div>
              <div class="visual-line visual-line--state"><span>STATE BENEFIT</span><i></i><em>PARTIAL</em></div>
              <div class="visual-label">Your state benefit may replace only part of it</div>
              <div class="visual-gap"><span>REMAINING GAP</span><strong>?</strong></div>
            </div>
            <div class="visual-footer"><span>STATE BENEFIT</span><b>+</b><span>MY INCOME SECURE</span></div>
          </div>
        </div>
      </section>

      <section class="thesis">
        <div class="thesis__inner">
          <div class="thesis__index">01</div>
          <div class="thesis__headline"><p class="section-kicker">The question that matters</p><h2>How much of your month survives if your paycheck doesn't?</h2></div>
          <div class="thesis__copy"><p>Most people know what they earn. Far fewer know what their unemployment benefit would actually replace — or what the remaining monthly shortfall would be.</p><p><strong>Let's calculate yours.</strong></p></div>
        </div>
      </section>

      <section class="coverage" id="coverage-check">
        <div class="coverage__head">
          <div>
            <p class="section-kicker">Your personalized coverage check</p>
            <h2>Put your own numbers on the table.</h2>
            <p>Choose your state, enter your approximate income and monthly costs, then confirm the actual enrollment criteria. The calculator uses the site's existing state-benefit formulas and returns one recommended protection amount.</p>
          </div>
          <div class="coverage__promise"><b>NO SALES QUIZ</b><span>Just the number that matters.</span></div>
        </div>

        <div class="flow" data-flow>
          <div class="flow__bar"><div class="flow__track"><i data-progress></i></div><div class="flow__meta"><span>STEP <b data-current>1</b> OF 4</span><strong data-name>STATE</strong></div></div>

          <form novalidate data-form>
            <fieldset data-step="0">
              <span class="step-no">01</span><legend>Where do you work?</legend><p>Your work state determines the unemployment formula used for the estimate.</p>
              <label class="sr-only" for="mis-state">State</label><select id="mis-state" data-state><option value="" selected disabled>Select your state</option></select>
            </fieldset>

            <fieldset data-step="1" hidden>
              <span class="step-no">02</span><legend>What do you earn?</legend><p>Use gross annual income before taxes. A rounded number is fine.</p>
              <label for="mis-income">Annual income</label><div class="money"><span>$</span><input id="mis-income" data-income type="number" min="1" step="1000" inputmode="numeric" placeholder="52,000" /></div>
              <div class="dependants" data-deps hidden><label for="mis-deps">Dependants</label><input id="mis-deps" data-deps-input type="number" min="0" max="10" value="0" /><small data-deps-hint></small></div>
            </fieldset>

            <fieldset data-step="2" hidden>
              <span class="step-no">03</span><legend>What does your month cost?</legend><p>Round numbers are fine. We are calculating the gap, not grading your budget.</p>
              <div class="expense-grid">
                <label>Housing<div class="money"><span>$</span><input data-expense type="number" min="0" step="50" placeholder="1,400" /></div></label>
                <label>Vehicle<div class="money"><span>$</span><input data-expense type="number" min="0" step="25" placeholder="450" /></div></label>
                <label>Everything else<div class="money"><span>$</span><input data-expense type="number" min="0" step="50" placeholder="750" /></div></label>
              </div>
            </fieldset>

            <fieldset data-step="3" hidden>
              <span class="step-no">04</span><legend>One last check.</legend><p>These are the actual enrollment attestations, shown here before any recommendation.</p>
              <div class="checks">
                {ELIGIBILITY_CRITERIA.map((c) => <label class="check"><input type="checkbox" data-eligibility={c.id} data-required={c.required ? 'true' : 'false'} /><span>{c.label}{c.detail && <small>{c.detail}</small>}</span></label>)}
              </div>
            </fieldset>

            <p class="flow-error" data-error hidden></p>
            <div class="flow-actions"><button class="back" type="button" data-back hidden>← Back</button><button class="next" type="button" data-next>Continue <span>→</span></button></div>
          </form>
        </div>
      </section>

      <section class="result" data-result hidden>
        <div class="result__inner">
          <div class="result__head"><p class="section-kicker">Your personalized result</p><h2>Now we know the gap.</h2><p>This is an estimate based on the state formula and numbers you entered — not an official determination.</p></div>
          <div class="result__grid">
            <div class="result__gap">
              <span class="result__label">ESTIMATED MONTHLY GAP</span>
              <strong data-out="gap">$0</strong>
              <p>The amount your monthly expenses still exceed your estimated state unemployment benefit.</p>
              <div class="result__rows"><div><span>Estimated state benefit</span><b data-out="benefit">$0</b></div><div><span>Monthly expenses</span><b data-out="expenses">$0</b></div></div>
              <div class="result__meter"><i data-meter></i></div>
              <div class="result__meter-labels"><span>State benefit</span><span>Expenses</span></div>
            </div>
            <div class="result__offer"><p>THE ONE RECOMMENDED PLAN</p><div data-rec></div><button class="restart" type="button" data-restart>Change my numbers →</button></div>
          </div>
        </div>
      </section>

      <section class="proof">
        <div class="proof__inner"><div class="proof__intro"><p class="section-kicker">Why the recommendation is simple</p><h2>The math does the choosing.</h2><p>Your state benefit establishes what you may receive. Your expenses establish what you still need. The existing plan ladder determines the least-expensive protection tier that can close the calculated shortfall.</p></div><div class="proof__steps"><article><span>01</span><b>Estimate</b><p>Your state + income produce the unemployment estimate.</p></article><article><span>02</span><b>Measure</b><p>Your expenses expose the monthly shortfall.</p></article><article><span>03</span><b>Match</b><p>One protection tier is recommended from the actual gap.</p></article></div></div>
      </section>

      <section class="details">
        <div class="details__inner"><div class="details__heading"><p class="section-kicker">Before you decide</p><h2>Know the rules. Then make the decision.</h2></div><div class="details__grid">
          <article><span>PAYMENT</span><b>{T.installments} installments</b><p>A qualifying claim is paid in {T.installments} installments, {T.installmentIntervalDays} days apart.</p></article>
          <article><span>TIMING</span><b>Before the job loss</b><p>{URGENCY}</p></article>
          <article><span>REFUND</span><b>{T.refundWindowHours}-hour window</b><p>A full refund is available within the stated window if no benefits have been used.</p></article>
          <article><span>STATE FILING</span><b>Still required</b><p>{STATE_FILING_REQUIREMENT}</p></article>
        </div></div>
      </section>

      <section class="eligibility">
        <div class="eligibility__inner"><div><p class="section-kicker">Eligibility</p><h2>You see the requirements before you enroll.</h2></div><div class="eligibility__list">{ELIGIBILITY_CRITERIA.map((c,i)=><div><span>{String(i+1).padStart(2,'0')}</span><p><b>{c.label}</b>{c.detail && <small>{c.detail}</small>}</p></div>)}</div></div>
      </section>

      <section class="faq">
        <div class="faq__inner"><div><p class="section-kicker">Questions</p><h2>Everything worth knowing before the next click.</h2></div><div class="faq__list">{faqs.map((item,i)=><details open={i===0}><summary>{item.q}<span>+</span></summary><div><p>{item.a}</p>{item.cta && <a href={item.cta.href}>{item.cta.label} →</a>}</div></details>)}</div></div>
      </section>

      <section class="close"><div class="close__inner"><p class="section-kicker">Start with your number</p><h2>Find out what a job loss could leave uncovered.</h2><p>Run the coverage check. See your number. Then see the protection amount the math recommends.</p><a class="close__cta" href="#coverage-check">Calculate my coverage gap <span>→</span></a></div></section>
    </main>
    <Footer minimal />
  </div>
</Base>

<script>
  import { STATES, findState, hasDependentAllowance, computeWeeklyBenefit, toMonthly } from '../lib/states.js';
  import { recommendPlan } from '../config/plans.js';
  import { saveCalcResult } from '../lib/storage.js';
  import { track, trackOnVisible, EVENTS, CALC_STEPS } from '../lib/analytics.js';
  import { money } from '../lib/format.js';

  const root = document.querySelector('.mis');
  const flow = root?.querySelector('[data-flow]');
  const result = root?.querySelector('[data-result]');

  if (flow && result) {
    const stateSel = flow.querySelector('[data-state]');
    const income = flow.querySelector('[data-income]');
    const depsField = flow.querySelector('[data-deps]');
    const depsInput = flow.querySelector('[data-deps-input]');
    const depsHint = flow.querySelector('[data-deps-hint]');
    const expenses = [...flow.querySelectorAll('[data-expense]')];
    const steps = [...flow.querySelectorAll('[data-step]')];
    const next = flow.querySelector('[data-next]');
    const back = flow.querySelector('[data-back]');
    const error = flow.querySelector('[data-error]');
    const current = flow.querySelector('[data-current]');
    const name = flow.querySelector('[data-name]');
    const progress = flow.querySelector('[data-progress]');
    const form = flow.querySelector('[data-form]');
    let step = 0;

    stateSel.innerHTML = '<option value="" selected disabled>Select your state</option>' + STATES.map((s) => `<option value="${s.code}">${s.name}</option>`).join('');
    track(EVENTS.CALC_START, { placement: 'homepage_flow' });

    const fail = (msg) => { error.textContent = msg; error.hidden = false; };
    const clearError = () => { error.hidden = true; };
    const setStep = (n, scroll = true) => {
      step = n;
      steps.forEach((el,i)=>{ el.hidden = i !== step; });
      current.textContent = step + 1;
      name.textContent = CALC_STEPS[step].toUpperCase();
      progress.style.width = `${((step + 1) / steps.length) * 100}%`;
      back.hidden = step === 0;
      clearError();
      const first = steps[step].querySelector('select,input');
      if (first) first.focus({ preventScroll: true });
      if (scroll) flow.scrollIntoView({ behavior:'smooth', block:'center' });
    };
    const expenseTotal = () => expenses.reduce((sum,el)=>sum + (parseFloat(el.value)||0),0);
    const validate = () => {
      if (step === 0 && !stateSel.value) return 'Choose your state to continue.';
      if (step === 1 && !(parseFloat(income.value) > 0)) return 'Enter your approximate annual income.';
      if (step === 2 && expenseTotal() <= 0) return 'Enter at least one monthly expense.';
      if (step === 3 && [...flow.querySelectorAll('[data-eligibility][data-required="true"]')].some((box)=>!box.checked)) return 'Please confirm every required eligibility statement before continuing.';
      return null;
    };
    const complete = () => {
      const problem = validate();
      if (problem) return fail(problem);
      track(EVENTS.CALC_STEP_COMPLETE, { placement:'homepage_flow', step:step+1, stepName:CALC_STEPS[step] });
      if (step === steps.length - 1) calculate(); else setStep(step+1);
    };
    stateSel.addEventListener('change', ()=>{ const s=findState(stateSel.value); const has=hasDependentAllowance(s); depsField.hidden=!has; if(has) depsHint.textContent=`${s.name} includes a dependent allowance of ${money(s.dep)} a week per dependant, up to ${s.depCap}.`; complete(); });
    next.addEventListener('click', complete);
    back.addEventListener('click', ()=>setStep(Math.max(0,step-1)));
    form.addEventListener('keydown',(e)=>{ if(e.key==='Enter' && e.target.matches('input[type="number"]')){ e.preventDefault(); complete(); } });

    function calculate(){
      const s=findState(stateSel.value); const annual=parseFloat(income.value)||0; const dependants=parseInt(depsInput.value,10)||0; const monthlyExpenses=expenseTotal();
      const weekly=computeWeeklyBenefit(s,annual,dependants); const monthlyBenefit=toMonthly(weekly); const monthlyGap=Math.max(0,monthlyExpenses-monthlyBenefit);
      const data={ stateCode:s.code,stateName:s.name,income:annual,deps:dependants,monthlyExpenses,weekly:Math.round(weekly),monthlyBenefit:Math.round(monthlyBenefit),monthlyGap:Math.round(monthlyGap) };
      saveCalcResult(data); paint(data,{monthlyBenefit,monthlyExpenses,monthlyGap}); track(EVENTS.GAP_REVEAL,{placement:'homepage_flow',state:s.code,monthlyGap:data.monthlyGap,monthlyBenefit:data.monthlyBenefit});
    }
    function paint(data,raw){
      flow.hidden=true; result.hidden=false;
      result.querySelector('[data-out="gap"]').textContent=money(raw.monthlyGap);
      result.querySelector('[data-out="benefit"]').textContent=`${money(raw.monthlyBenefit)}/month`;
      result.querySelector('[data-out="expenses"]').textContent=`${money(raw.monthlyExpenses)}/month`;
      result.querySelector('[data-meter]').style.width=`${raw.monthlyExpenses>0?Math.min(100,(raw.monthlyBenefit/raw.monthlyExpenses)*100):0}%`;
      const target=result.querySelector('[data-rec]'); target.innerHTML='';
      if(raw.monthlyGap<=0){ target.innerHTML='<div class="no-gap"><strong>Your estimate covers the monthly amount you entered.</strong><p>There is no calculated shortfall to match to a protection tier.</p></div>'; }
      else { const rec=recommendPlan(raw.monthlyGap); if(rec.plan){ const remaining=Math.max(0,raw.monthlyGap-rec.plan.monthlyBenefit); const match=rec.closesGap?`Closes your ${money(raw.monthlyGap)} estimated monthly shortfall.`:`Covers ${money(rec.plan.monthlyBenefit)} of your ${money(raw.monthlyGap)} estimated monthly shortfall, leaving ${money(remaining)}.`; target.innerHTML=`<article class="rec"><span class="rec__flag">RECOMMENDED</span><h3>${rec.plan.name}</h3><strong>${money(rec.plan.totalLimit)}</strong><small>total benefit</small><p>${rec.plan.installments} payments of ${money(rec.plan.monthlyBenefit)}, ${rec.plan.installmentIntervalDays} days apart</p><div class="rec__match">${match}</div><div class="rec__price">${money(rec.plan.priceMonthly)}<small>/month membership</small></div><a class="rec__cta" data-plan="${rec.plan.id}" href="${ROUTES.checkout}?plan=${rec.plan.id}">Continue with ${money(rec.plan.totalLimit)} protection <span>→</span></a></article>`; const cta=target.querySelector('[data-plan]'); cta.addEventListener('click',()=>{ track(EVENTS.PLAN_SELECT,{placement:'homepage_flow',planId:rec.plan.id,recommended:true}); track(EVENTS.CHECKOUT_START,{placement:'homepage_flow',planId:rec.plan.id}); }); trackOnVisible(target.querySelector('.rec'),EVENTS.PLAN_VIEW,{placement:'homepage_flow'}); } }
      result.scrollIntoView({behavior:'smooth',block:'start'});
    }
    root.querySelector('[data-restart]').addEventListener('click',()=>{ result.hidden=true; flow.hidden=false; setStep(1); });
    setStep(0,false);
  }
</script>

<style>
  .mis{--ink:#0c1730;--ink2:#17243f;--muted:#667085;--line:#d9e0ea;--paper:#fff;--wash:#f4f7fb;--blue:#2859e8;--blue2:#1743bd;--lime:#d8f477;--green:#17804f;--orange:#f4a340;background:var(--paper);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;overflow-x:clip}.mis *{box-sizing:border-box}.mis a{color:inherit}.header{border-bottom:1px solid var(--line);background:#fff}.header__inner{width:min(1240px,calc(100% - 40px));min-height:72px;margin:auto;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;text-decoration:none}.brand__mark{width:34px;height:34px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:900;font-size:10px}.brand__text b{display:block;font-size:15px;letter-spacing:-.02em}.brand__text small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.header__cta{font-size:13px;font-weight:850;color:var(--blue)!important;text-decoration:none}
  .hero{background:var(--ink);color:#fff}.hero__inner{width:min(1240px,calc(100% - 40px));min-height:720px;margin:auto;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(390px,.9fr);gap:64px;align-items:center}.hero__copy{padding:80px 0}.eyebrow,.section-kicker{margin:0 0 18px;font-size:11px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.eyebrow{display:flex;gap:8px;align-items:center;color:var(--lime)}.eyebrow i{width:8px;height:8px;background:var(--lime)}.hero h1{margin:0;max-width:9ch;font-size:clamp(56px,7vw,100px);line-height:.91;letter-spacing:-.06em}.hero__lead{max-width:680px;color:#c8d1df;margin:27px 0 0;font-size:clamp(18px,1.35vw,21px);line-height:1.5}.hero__offer{margin:33px 0 24px;width:min(610px,100%);padding:18px 20px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.04)}.hero__offer>div:not(.hero__offer-line){display:grid;grid-template-columns:auto auto;align-items:end;gap:0 7px}.hero__offer span{grid-column:1/-1;color:#8996aa;font-size:10px;font-weight:900;letter-spacing:.14em;margin-bottom:5px}.hero__offer strong{font-size:30px;line-height:1;letter-spacing:-.04em}.hero__offer small{color:#9ca8b8;font-size:12px}.hero__offer-line{width:1px;height:42px;background:rgba(255,255,255,.15)}.hero__cta,.close__cta{min-height:58px;display:inline-flex;align-items:center;justify-content:center;gap:15px;padding:0 24px;background:var(--lime);color:var(--ink)!important;text-decoration:none;font-weight:900;font-size:15px}.hero__micro{margin:10px 0 0;color:#7e8b9f;font-size:12px}.hero__bullets{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:29px;color:#d5dbe5;font-size:12px;font-weight:700}.hero__bullets b{color:var(--lime);margin-right:5px}.hero-visual{background:#151f34;border:1px solid rgba(255,255,255,.12);padding:25px;box-shadow:0 24px 70px rgba(0,0,0,.28)}.visual-header,.visual-footer{display:flex;justify-content:space-between;color:#8693a6