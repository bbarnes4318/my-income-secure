---
// The homepage sells first, then guides. The hero establishes what this is,
// why it matters, and what it costs before anyone is asked a question — the
// coverage check (CoverageFlow) is a mid-page section, not the opening act.
// The full plan ladder, the standalone calculator, and the filing guide are
// untouched and still reachable directly; nothing on this page links to them
// except the filing guide, which is genuinely relevant reading.
import Page from '../layouts/Page.astro';
import CoverageFlow from '../components/CoverageFlow.astro';
import Faq from '../components/Faq.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { ROUTES, URGENCY, STATE_FILING_REQUIREMENT } from '../config/site.js';
import { PROGRAM_TERMS, PLANS } from '../config/plans.js';
import { money, price } from '../lib/format.js';

const T = PROGRAM_TERMS;
const cheapest = PLANS[0];
const largest = PLANS[PLANS.length - 1];

const trustItems = [
  {
    label: 'Clear pricing',
    detail: `Plans start at ${price(cheapest.priceMonthly)}/month. No hidden fees.`,
  },
  {
    label: 'No medical exam',
    detail: "Enrollment is based on your employment, not your health.",
  },
  {
    label: 'Cancel anytime',
    detail: `A full refund is available within ${T.refundWindowHours} hours of purchase if no benefits have been used.`,
  },
  {
    label: 'Transparent payout',
    detail: `Paid in ${T.installments} installments, ${T.installmentIntervalDays} days apart, starting ${T.firstInstallmentDays} days after a qualifying job loss.`,
  },
  {
    label: 'State unemployment, explained plainly',
    detail: STATE_FILING_REQUIREMENT,
  },
  {
    label: 'Clear eligibility',
    detail: 'You see exactly what you are attesting to before you enroll — nothing is revealed after the fact.',
  },
];

const faqs = [
  {
    q: 'How is this different from insurance?',
    a:
      'It is a membership benefit program, not an insurance product. You are not ' +
      'buying a policy and there is no insurer indemnifying a loss. You hold a ' +
      'membership that pays a fixed benefit if you lose your job.',
  },
  {
    q: 'When can I make a claim?',
    a:
      `A claim becomes admissible after ${T.claimThresholdDays} consecutive days ` +
      `unemployed, and the first payment arrives ${T.firstInstallmentDays} days ` +
      'after the qualifying job loss. Your membership has to be in place before ' +
      'the job loss happens — it does not reach backwards.',
  },
  {
    q: 'Do I still apply for unemployment?',
    a:
      'Yes. A claim requires you to be eligible for and approved to receive ' +
      'state unemployment benefits for the same period you are claiming. If you ' +
      'never file with your state, there is nothing here to pay out on.',
    cta: { href: ROUTES.guide, label: 'Read the filing guide' },
  },
  {
    q: 'What happens if I go back to work?',
    a:
      "Each installment after the first is paid only if you're still " +
      'unemployed. Back at work before all of them are paid, and the ' +
      'remaining ones are forfeited.',
  },
  {
    q: 'Can I cancel, and can I get a refund?',
    a:
      `You can cancel at any time. A full refund is available within ` +
      `${T.refundWindowHours} hours of purchase, provided no benefits have ` +
      'been used. There is no refund after that window.',
  },
  {
    q: 'What if I quit rather than getting laid off?',
    a:
      'The program exists for job loss you did not choose. Resigning ' +
      'voluntarily is not the situation it is built to cover.',
  },
];
---

<Page
  title="If you lost your job tomorrow, how long could your savings carry you? — My Income Secure"
  description={`My Income Secure pays up to ${money(largest.totalLimit)} in job-loss income protection while you look for your next job — starting at ${price(cheapest.priceMonthly)}/month.`}
  landing
>
  <section class="hero">
    <div class="shell hero__shell">
      <div class="hero__figure">
        <ImageSlot name="home-hero" ratio="4 / 5" />
      </div>

      <div class="hero__text">
        <p class="hero__eyebrow">Job-loss income protection</p>
        <h1>If you lost your job tomorrow, how long could your savings carry you?</h1>
        <p class="hero__lead">
          My Income Secure pays up to {money(largest.totalLimit)} in job-loss
          income protection while you look for your next job &mdash; paid
          directly to you.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#coverage-check">See what I'd get</a>
          <p class="hero__price">Plans start at {price(cheapest.priceMonthly)}/month.</p>
        </div>

        <ul class="hero__trust">
          <li>No medical exam</li>
          <li>Cancel anytime</li>
          <li>Benefit begins with a qualifying job loss</li>
          <li>Paid directly to you</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight section--alt promise">
    <div class="shell promise__shell">
      <div class="promise__item">
        <span class="promise__value">Up to {money(largest.totalLimit)}</span>
        <span class="promise__label">paid to you if you lose your job</span>
      </div>
      <div class="promise__item">
        <span class="promise__value">{T.installments} payments</span>
        <span class="promise__label">{T.installmentIntervalDays} days apart</span>
      </div>
      <div class="promise__item">
        <span class="promise__value">Stops</span>
        <span class="promise__label">the moment you're back at work</span>
      </div>
    </div>
  </section>

  <CoverageFlow />

  <section class="section trust">
    <div class="shell">
      <p class="eyebrow">Straightforward, on purpose</p>
      <h2>What you should know before you enroll.</h2>
      <dl class="trust__grid">
        {
          trustItems.map((item) => (
            <div class="trust__item">
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--tight section--warm">
    <div class="shell">
      <h2>Before you enroll, here's what matters.</h2>
      <div class="faq-wrap">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <section class="section section--generous section--deep close">
    <div class="shell shell--text">
      <p class="eyebrow">One more thing</p>
      <h2>If you could lose your paycheck tomorrow, would you rather have a plan in place?</h2>
      <p class="lead">{URGENCY}</p>
      <p class="close__price">Plans start at {price(cheapest.priceMonthly)}/month.</p>
      <a class="btn btn--primary" href="#coverage-check">See what I'd get &rarr;</a>
    </div>
  </section>
</Page>

<style>
  /* --- Hero ---------------------------------------------------------------
     Mobile-first: the image runs first in the DOM (a real top-of-page
     moment, not something hidden), then the sales copy. Desktop reorders it
     beside the copy via flex order, and gives it its intended portrait crop. */
  .hero {
    background: var(--blue-pale);
    border-bottom: 1px solid var(--line);
  }

  .hero__shell {
    display: flex;
    flex-direction: column;
    padding-block: 0 var(--pad-generous);
  }

  .hero__figure {
    margin-inline: calc(clamp(1.25rem, 0.75rem + 2vw, 2.5rem) * -1);
  }

  .hero__figure :global(.slot) {
    aspect-ratio: 16 / 10;
    border-radius: 0;
    box-shadow: none;
  }

  .hero__text {
    padding-top: var(--pad-tight);
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-ink);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    max-width: 18ch;
  }

  .hero__lead {
    max-width: 46ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--ink);
  }

  .hero__cta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__price {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .hero__trust {
    margin: var(--space-6) 0 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
    display: grid;
    gap: var(--space-2) var(--space-6);
  }

  .hero__trust li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .hero__trust li::before {
    content: '\2713';
    color: var(--covered-ink);
    font-weight: 800;
  }

  @media (min-width: 780px) {
    .hero__shell {
      flex-direction: row;
      align-items: center;
      gap: var(--space-9);
      padding-block: var(--pad-generous);
    }

    .hero__figure {
      order: 2;
      flex: 0 0 42%;
      margin-inline: 0;
    }

    .hero__figure :global(.slot) {
      aspect-ratio: 4 / 5;
      border-radius: var(--radius);
      border: 1px solid var(--line-strong);
      box-shadow: var(--shadow-raised);
    }

    .hero__text {
      order: 1;
      flex: 1 1 auto;
      padding-top: 0;
    }
  }

  /* --- Quick coverage promise --------------------------------------------
     Plain figures separated by rule lines, not cards — the numbers carry it. */
  .promise__shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .promise__item {
    padding-top: var(--space-4);
    border-top: 2px solid var(--navy);
  }

  .promise__value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--navy);
  }

  .promise__label {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (min-width: 700px) {
    .promise__shell {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  /* --- Trust --- */
  .trust__grid {
    margin: var(--space-7) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .trust__item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }

  .trust__item dt {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--navy);
    font-size: var(--text-base);
  }

  .trust__item dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: 40ch;
  }

  @media (min-width: 700px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-8);
    }
  }

  /* --- FAQ --- */
  .faq-wrap {
    margin-top: var(--space-5);
    max-width: var(--measure);
  }

  /* --- Close --- */
  .close h2 {
    max-width: 22ch;
    margin-top: var(--space-2);
  }

  .close .lead {
    margin-block: var(--space-4) var(--space-3);
  }

  .close__price {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #9fb3d1;
    margin-bottom: var(--space-6);
  }
</style>
